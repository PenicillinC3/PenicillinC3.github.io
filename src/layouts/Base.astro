---
import '../styles/tokens.css';
import '../styles/base.css';
import { ViewTransitions } from 'astro:transitions';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Preloader from '../components/Preloader.astro';
import { site } from '../site.config';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  /** 暗房页（spec §21.1）：body.page-dark 覆写全局 token 为暗色 */
  dark?: boolean;
  /** 沉浸页（spec §21.1）：body.page-immersive 隐藏页脚、main padding 归零 */
  immersive?: boolean;
  /** 画廊页（spec §27.1）：body.page-gallery —— 视口锁高无滚动，页脚保留，
      main 占顶栏与页脚之间的全部剩余（胶片画廊形态） */
  gallery?: boolean;
}
const { title, description = site.tagline, noindex, dark = false, immersive = false, gallery = false } = Astro.props;
const headTitle = title ? `${title} · ${site.title}` : `${site.title} — ${site.tagline}`;
// spec §33：页脚仅首页显示（其余页面移除最下方栏）
const isHome = Astro.url.pathname === '/';
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{headTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <ViewTransitions />
  </head>
  <body class:list={['base-body', dark && 'page-dark', immersive && 'page-immersive', gallery && 'page-gallery']}>
    {/* §101：进站加载页 —— 仅首页、仅本会话首次整页加载；必须是 body 首个元素
        （首帧即它，不会先闪一下网站）。内页直接进入不渲染（isHome 判断）。 */}
    {isHome && <Preloader />}
    <Nav />
    <main class="wrap main"><slot /></main>
    {isHome && <Footer />}
  </body>
</html>
