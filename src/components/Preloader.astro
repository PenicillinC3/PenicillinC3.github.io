---
import { devPreloadUrls } from '../lib/prefetch-manifest';
import { site } from '../site.config';
import regular from '../../_font/Anthropic Sans/AnthropicSans-Text-Regular-Static.otf?url';
import bold from '../../_font/Anthropic Sans/AnthropicSans-Display-Bold-Static.otf?url';

interface Props { preview?: boolean }
const { preview = false } = Astro.props;
const devUrls = import.meta.env.DEV && !preview ? [...await devPreloadUrls(), regular, bold] : null;
const rowInterval = 900;
const typeDuration = 380;
const logRows = [
  'document.ready()', 'load(pages)', 'load(styles, scripts)', 'load(fonts)',
];

const animals = {
  rabbit: {
    frames: [
      [' (\\_/) ', ' (o.o) ', 'c(")(")'],
      [' (\\_/) ', ' (-.-) ', 'c(")(")'],
    ],
    marks: '.  v',
  },
  fish: {
    frames: [
      ['       o', '><((*> .', '        '],
      ['        ', '><((*> o', '        '],
    ],
    marks: '~  .',
  },
  turtle: {
    frames: [
      ['  _____   ', ' /_/_/_\\o_', '  "   "   '],
      ['  _____   ', ' /_/_/_\\_o', '   " "    '],
    ],
    marks: '+  .',
  },
  frog: {
    frames: [
      [' o   o ', '(  -  )', '/(> <)\\', '  ^ ^  '],
      [' o   o ', '(  _  )', ' (> <) ', '/_^ ^_\\'],
    ],
    marks: ".  ''",
  },
};

const animalSides = [
  { side: 'left', names: ['rabbit', 'turtle'] },
  { side: 'right', names: ['fish', 'frog'] },
] as const;
---

<style is:inline set:html={`
  @font-face { font-family: 'Anthropic Sans'; src: url(${JSON.stringify(regular)}) format('opentype'); font-weight: 400; font-display: swap; }
  @font-face { font-family: 'Anthropic Sans'; src: url(${JSON.stringify(bold)}) format('opentype'); font-weight: 700; font-display: swap; }
`} />

<style is:inline>
  html:has(> body > #entry-loader) {
    background-color: var(--entry-canvas);
    overflow: hidden;
  }

  #entry-loader {
    --entry-open-time: 520ms;
    --entry-open-ease: cubic-bezier(.68, 0, .22, 1);
    position: fixed;
    inset: 0;
    z-index: 9999;
    overflow: hidden;
    isolation: isolate;
    color: var(--entry-ink);
    font-family: 'Anthropic Sans', sans-serif;
  }

  .entry-pane {
    position: absolute;
    inset-block: 0;
    width: calc(50% + 1px);
    background: var(--entry-canvas);
    transition: transform var(--entry-open-time) var(--entry-open-ease);
  }

  .entry-pane-left { left: 0; }
  .entry-pane-right { right: 0; }
  [data-phase="open"] .entry-pane-left { transform: translateX(-100%); }
  [data-phase="open"] .entry-pane-right { transform: translateX(100%); }

  .entry-log {
    position: absolute;
    top: clamp(20px, 8vh, 76px);
    left: clamp(16px, 6vw, 96px);
    right: 12px;
    display: grid;
    gap: .7em;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 1.125rem;
    line-height: 1.2;
    transition: opacity 140ms ease-out;
  }

  .entry-log-row {
    display: flex;
    align-items: baseline;
    gap: .8em;
    white-space: nowrap;
    animation: entry-log-shift 250ms cubic-bezier(.2, .7, .2, 1)
      calc(var(--log-delay) + var(--log-type-time)) both;
  }

  .entry-log-code {
    color: var(--entry-code);
    animation: entry-type var(--log-type-time) steps(var(--log-steps), end) var(--log-delay) both;
  }

  .entry-log-keyword { color: var(--entry-blue); }

  .entry-log-state {
    color: var(--entry-code);
    font-size: .85em;
    animation: entry-show 1ms calc(var(--log-delay) + var(--log-type-time)) both;
  }

  .entry-log-row[data-state="ready"] .entry-log-state { color: var(--entry-green); }
  .entry-log-row[data-state="error"] .entry-log-state { color: var(--entry-orange); }

  .entry-animal {
    position: absolute;
    left: var(--animal-x);
    top: var(--animal-y);
    display: grid;
    transform: translate(-50%, -50%);
    color: var(--animal-color);
    opacity: 0;
  }

  .entry-animal.is-cued {
    animation: entry-animal-pass 590ms steps(1, end) var(--animal-delay) both;
  }

  .entry-animal-rabbit {
    --animal-x: 44%;
    --animal-y: 31%;
    --animal-color: var(--entry-ink);
    --animal-cycle: 1220ms;
    --animal-dy: -2px;
  }

  .entry-animal-fish {
    --animal-x: 58%;
    --animal-y: 26%;
    --animal-color: var(--entry-blue);
    --animal-cycle: 1060ms;
    --animal-dx: 8px;
    --animal-dy: -2px;
  }

  .entry-animal-turtle {
    --animal-x: 59%;
    --animal-y: 72%;
    --animal-color: var(--entry-orange);
    --animal-cycle: 1480ms;
    --animal-dx: 4px;
  }

  .entry-animal-frog {
    --animal-x: 42%;
    --animal-y: 68%;
    --animal-color: var(--entry-green);
    --animal-cycle: 970ms;
    --animal-dy: -7px;
  }

  .entry-animal-art {
    display: grid;
  }

  .entry-animal.is-cued .entry-animal-art {
    animation: entry-animal-motion var(--animal-cycle) steps(3, end) var(--animal-delay) infinite both;
  }

  .entry-animal-frame {
    grid-area: 1 / 1;
    margin: 0;
    font: inherit;
    line-height: 1.06;
    font-variant-ligatures: none;
    white-space: pre;
  }

  .entry-animal-line { display: block; min-height: 1.06em; }
  .entry-animal-line span { display: inline-block; width: .72em; text-align: center; }

  .entry-animal.is-cued .entry-animal-frame {
    animation: entry-animal-frame var(--animal-cycle) steps(1, end) var(--animal-delay) infinite both;
  }

  .entry-animal-frame + .entry-animal-frame {
    --frame-rest: 0;
    --frame-action: 1;
  }

  .entry-animal-marks {
    position: absolute;
    top: -.85em;
    left: calc(100% + .45em);
    color: var(--entry-green);
    font-size: .75em;
    line-height: 1;
    white-space: pre;
  }

  .entry-animal.is-cued .entry-animal-marks {
    animation: entry-animal-marks var(--animal-cycle) steps(1, end) var(--animal-delay) infinite both;
  }

  .entry-pane-right .entry-animal-marks {
    top: auto;
    bottom: -.75em;
    right: calc(100% + .5em);
    left: auto;
    color: var(--entry-blue);
  }

  .entry-heading {
    position: absolute;
    top: calc(50% - clamp(35px, 5.2vw, 48px));
    left: 50%;
    transform: translate(-50%, -100%);
    display: grid;
    justify-items: center;
    text-align: center;
    gap: clamp(14px, 2.2vw, 22px);
    width: max-content;
    transition: opacity 140ms ease-out;
  }

  .entry-name {
    margin: 0;
    font-size: 3.875rem;
    line-height: 1.04;
    font-weight: 700;
    padding-inline: .07em;
    animation: entry-type 360ms steps(12, end) both;
  }

  .entry-meter {
    display: flex;
    gap: .55em;
    font-size: 1.125rem;
    line-height: 1;
    animation: entry-show 1ms 210ms both;
  }

  .entry-number {
    min-width: 4ch;
    text-align: left;
    color: var(--entry-blue);
    font-variant-numeric: tabular-nums;
  }

  .entry-track {
    --entry-cell: clamp(21px, 3.6vw, 38px);
    position: absolute;
    top: 50%;
    left: 50%;
    width: max-content;
    transform: translate(-50%, -50%);
    display: flex;
    align-items: center;
    justify-content: space-between;
    column-gap: .12em;
    font-size: 5rem;
    line-height: 1;
    animation: entry-show 1ms 260ms both;
  }

  .entry-dot {
    display: grid;
    place-items: center;
    flex: 0 0 var(--entry-cell);
    height: var(--entry-cell);
    color: var(--entry-blue);
  }

  .entry-dot::after {
    content: '';
    width: 66%;
    aspect-ratio: 1;
    background: currentColor;
    border-radius: 50%;
  }

  .entry-dot.is-ready { color: var(--entry-green); }
  .entry-dot[hidden] { display: none; }
  #entry-loader:not([data-phase="load"]) :is(.entry-heading, .entry-log) { opacity: 0; }
  #entry-loader[data-phase="open"] .entry-track {
    width: calc(100% + 2em);
    transition: width var(--entry-open-time) var(--entry-open-ease);
  }

  @keyframes entry-type {
    from { clip-path: inset(0 100% 0 0); }
    to { clip-path: inset(0); }
  }
  @keyframes entry-show { from { opacity: 0; } to { opacity: 1; } }
  @keyframes entry-log-shift {
    from { transform: translate(1.3em, .45em); }
    to { transform: translate(0, 0); }
  }
  @keyframes entry-animal-pass {
    0% { opacity: 0; translate: 0 0; }
    12% { opacity: .85; translate: 0 0; }
    38% { opacity: .65; translate: 0 -4px; }
    71%, 100% { opacity: .85; translate: 0 -4px; }
  }
  @keyframes entry-animal-motion {
    0%, 20%, 80%, 100% { translate: 0 0; }
    50% { translate: var(--animal-dx, 0px) var(--animal-dy, 0px); }
  }
  @keyframes entry-animal-frame {
    0%, 65% { opacity: var(--frame-rest, 1); }
    40% { opacity: var(--frame-action, 0); }
  }
  @keyframes entry-animal-marks {
    0%, 65% { opacity: .5; }
    40% { opacity: .2; }
  }
  @media (max-width: 600px) {
    .entry-name { font-size: 2rem; }
    .entry-meter { font-size: .875rem; }
    .entry-track { font-size: 3rem; }
    .entry-log, .entry-animal { font-size: .8125rem; }
    .entry-animal-rabbit { --animal-y: 24%; }
    .entry-animal-fish { --animal-y: 19%; }
    .entry-animal-turtle { --animal-y: 77%; }
    .entry-animal-frog { --animal-y: 72%; }
  }

  @media (max-height: 580px) {
    .entry-log { top: 14px; gap: .32em; font-size: .8125rem; }
    .entry-animal-rabbit, .entry-animal-fish { --animal-y: 17%; }
    .entry-animal-turtle, .entry-animal-frog { --animal-y: 80%; }
  }

  @media (prefers-reduced-motion: reduce) {
    #entry-loader * { animation: none !important; transition: none !important; }
  }
</style>

<!-- The template stays inert on client-side navigation and without JavaScript. -->
<template id="entry-loader-template">
  <div id="entry-loader" data-phase="load">
    {animalSides.map(({ side, names }) => (
      <div class:list={['entry-pane', 'entry-pane-' + side]} aria-hidden="true">
        {names.map(name => (
          <div class:list={['entry-animal', 'entry-animal-' + name]}>
            <div class="entry-animal-art">
              {animals[name].frames.map(lines => (
                <div class="entry-animal-frame">
                  {lines.map(line => (
                    <span class="entry-animal-line">{[...line].map(char => <span>{char}</span>)}</span>
                  ))}
                </div>
              ))}
            </div>
            <span class="entry-animal-marks">{animals[name].marks}</span>
          </div>
        ))}
      </div>
    ))}
    <ol class="entry-log" aria-hidden="true" style={'--log-type-time:' + typeDuration + 'ms'}>
      {logRows.map((command, index) => (
        <li class="entry-log-row" style={'--log-delay:' + index * rowInterval + 'ms;--log-steps:' + (command.length + 6)}>
          <span class="entry-log-code"><span class="entry-log-keyword">await</span>{' '}{command}</span>
          <span class="entry-log-state">waiting</span>
        </li>
      ))}
    </ol>
    <div class="entry-heading">
      <p class="entry-name">{site.title}</p>
      <div class="entry-meter" role="progressbar" aria-label="全站加载进度" aria-valuenow="0">
        <span>Loading</span><span class="entry-number">0%</span>
      </div>
    </div>
    <div class="entry-track" aria-hidden="true">
      <span>[</span>
      {Array.from({ length: 6 }, () => <span class="entry-dot"></span>)}
      <span>]</span>
    </div>
  </div>
</template>

<script is:inline define:vars={{ devUrls, preview, rowInterval, typeDuration }}>
  (function runLoader() {
    if (!preview && document.readyState !== 'loading') return;
    const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const playedKey = 'plPlayed';
    if (!preview) {
      try {
        if (sessionStorage.getItem(playedKey)) return;
        sessionStorage.setItem(playedKey, '1');
      } catch { /* Storage can be disabled. */ }
    }

    const template = document.getElementById('entry-loader-template');
    const loader = template.content.firstElementChild.cloneNode(true);
    const meter = loader.querySelector('.entry-meter');
    const number = loader.querySelector('.entry-number');
    const dots = [...loader.querySelectorAll('.entry-dot')];
    const rows = [...loader.querySelectorAll('.entry-log-row')];
    const animals = ['rabbit', 'fish', 'turtle', 'frog'].map(name => loader.querySelector('.entry-animal-' + name));
    const minPlaybackTime = 5000;
    const completedHold = 135;
    const compactHold = 95;
    const dotInterval = 90;
    const openTime = 520;
    const openBuffer = 40;
    const dotPairs = [[0, 5], [1, 4], [2, 3]];
    const exitTime = compactHold + dotPairs.length * dotInterval + openTime + openBuffer;
    const progressDelay = 200;
    const progressDuration = minPlaybackTime - completedHold - exitTime - progressDelay;
    const started = performance.now();
    document.body.append(loader);

    let lastValue = -1;

    function showProgress(value) {
      if (value === lastValue) return;
      lastValue = value;
      number.textContent = value + '%';
      meter.setAttribute('aria-valuenow', value);
      const readyDots = Math.floor(value * dots.length / 100);
      dots.forEach((dot, index) => dot.classList.toggle('is-ready', index < readyDots));
    }

    const wait = ms => new Promise(resolve => setTimeout(resolve, ms));
    const stages = rows.map(() => ({ done: 0, total: 0, failed: 0 }));
    const knownResources = new Set();
    let frame;

    function cueAnimal(index) {
      if (reduceMotion) return;
      const animal = animals[index];
      const earliestTime = index * rowInterval + typeDuration + 65;
      const delay = Math.max(0, earliestTime - (performance.now() - started));
      animal.style.setProperty('--animal-delay', delay + 'ms');
      animal.classList.add('is-cued');
    }

    function paintStage(index) {
      const row = rows[index];
      const { done, total, failed } = stages[index];
      const complete = done + failed === total;
      if (complete) {
        row.dataset.state = failed ? 'error' : 'ready';
        if (!failed) cueAnimal(index);
      }
      row.querySelector('.entry-log-state').textContent =
        failed ? done + '/' + total + ' · ' + failed + ' failed' : done + '/' + total + (complete ? ' OK' : '');
    }

    async function read(url, mode = 'buffer') {
      for (let attempt = 0; ; attempt++) {
        const controller = new AbortController();
        const timeout = setTimeout(() => controller.abort(), 60000);
        try {
          const response = await fetch(url, { cache: 'force-cache', signal: controller.signal });
          const requestedUrl = new URL(url, location.origin);
          const responseUrl = new URL(response.url);
          const expectedNotFound = requestedUrl.pathname === '/404.html'
            && responseUrl.href === requestedUrl.href
            && response.status === 404
            && response.headers.get('content-type')?.startsWith('text/html');
          if ((!response.ok && !expectedNotFound) || responseUrl.origin !== location.origin) {
            throw new Error('Failed to preload ' + url);
          }
          if (mode === 'json') return await response.json();
          if (mode === 'text') return await response.text();
          return await response.arrayBuffer();
        } catch (error) {
          if (attempt || controller.signal.aborted) throw error;
          await wait(350);
        } finally {
          clearTimeout(timeout);
        }
      }
    }

    async function loadStage(index, urls, load = read) {
      const stage = stages[index];
      stage.total = urls.length;
      paintStage(index);
      const queue = urls.values();
      async function worker() {
        for (const url of queue) {
          try {
            await load(url);
            stage.done++;
          } catch {
            stage.failed++;
          }
          paintStage(index);
        }
      }
      await Promise.all(Array.from({ length: Math.min(5, urls.length) }, worker));
    }

    function devDependencies(html, pageUrl) {
      const page = document.createElement('template');
      page.innerHTML = html;
      const links = page.content.querySelectorAll('link[rel="stylesheet"][href], link[rel="modulepreload"][href], script[src], astro-island[component-url], astro-island[renderer-url]');
      for (const link of links) {
        for (const attribute of ['href', 'src', 'component-url', 'renderer-url']) {
          const value = link.getAttribute(attribute);
          if (value) {
            const url = new URL(value, pageUrl);
            if (url.origin === location.origin) knownResources.add(url.href);
          }
        }
      }
    }

    async function loadSite() {
      if (preview) {
        const sampleTotals = [1, 14, 12, 10];
        await Promise.all(sampleTotals.map((total, index) => (async () => {
          const stage = stages[index];
          stage.total = total;
          paintStage(index);
          await wait(index * rowInterval + 480);
          for (let done = 0; done < total; done++) {
            await wait(90);
            stage.done++;
            paintStage(index);
          }
        })()));
        return;
      }

      const documentReady = loadStage(0, [location.href], () =>
        new Promise(resolve => addEventListener('DOMContentLoaded', resolve, { once: true })),
      );
      let urls;
      try {
        urls = devUrls ?? await read('/site-preload.json', 'json');
      } catch {
        stages[1].total = stages[1].failed = 1;
        paintStage(1);
        await documentReady;
        return;
      }
      const pages = [];
      const scripts = [];
      const fonts = [];
      for (const path of urls) {
        const url = new URL(path, location.origin);
        if (url.origin !== location.origin) continue;
        if (url.pathname.endsWith('/') || url.pathname.endsWith('.html')) pages.push(url.href);
        if (/\.(css|m?js)$/i.test(url.pathname)) scripts.push(url.href);
        if (/\.(woff2?|otf|ttf)$/i.test(url.pathname)) fonts.push(url.href);
      }
      const activePage = window.location.origin + window.location.pathname;
      const pageLoading = loadStage(1, pages, async url => {
        if (url === activePage && !devUrls) return documentReady;
        if (devUrls) return devDependencies(await read(url, 'text'), url);
        await read(url);
      });
      const fontLoading = loadStage(3, fonts);
      if (devUrls) {
        await pageLoading;
        scripts.push(...knownResources);
      }
      await Promise.all([documentReady, pageLoading, fontLoading, loadStage(2, scripts)]);
    }

    function tick(now) {
      const done = stages.reduce((sum, stage) => sum + stage.done, 0);
      const total = stages.reduce((sum, stage) => sum + stage.total, 0);
      const target = total ? 100 * done / total : 0;
      const paced = 100 * (now - started - progressDelay) / progressDuration;
      showProgress(Math.max(0, Math.floor(Math.min(target, paced, 99))));
      frame = requestAnimationFrame(tick);
    }
    frame = requestAnimationFrame(tick);

    async function play() {
      await loadSite();
      const loaded = stages.every(stage => !stage.failed);

      if (preview) {
        await wait(Math.max(0, minPlaybackTime - (performance.now() - started)));
        cancelAnimationFrame(frame);
        showProgress(100);
        if (!reduceMotion) {
          await wait(1100);
          loader.remove();
          runLoader();
        }
        return;
      }

      if (reduceMotion) {
        await wait(Math.max(0, minPlaybackTime - (performance.now() - started)));
        cancelAnimationFrame(frame);
        loader.remove();
        return;
      }

      const availableTime = minPlaybackTime - (performance.now() - started);
      const fullExitTime = exitTime + (loaded ? completedHold : 0);
      // Fit the exit into the minimum playback window when resources settle in time.
      const exitScale = availableTime > 0 ? Math.min(1, availableTime / fullExitTime) : 1;
      if (availableTime > fullExitTime) await wait(availableTime - fullExitTime);

      cancelAnimationFrame(frame);
      if (loaded) {
        showProgress(100);
        await wait(completedHold * exitScale);
      }
      loader.dataset.phase = 'compact';
      await wait(compactHold * exitScale);
      for (const [start, end] of dotPairs) {
        dots[start].hidden = true;
        dots[end].hidden = true;
        await wait(dotInterval * exitScale);
      }

      // Give the empty brackets a frame at their natural width before opening.
      const track = loader.querySelector('.entry-track');
      track.style.width = track.getBoundingClientRect().width + 'px';
      await new Promise(resolve => requestAnimationFrame(() => requestAnimationFrame(resolve)));
      track.style.removeProperty('width');
      loader.style.setProperty('--entry-open-time', openTime * exitScale + 'ms');
      loader.dataset.phase = 'open';
      await wait(Math.max((openTime + openBuffer) * exitScale, minPlaybackTime - (performance.now() - started)));
      loader.remove();
    }
    void play().catch(async () => {
      cancelAnimationFrame(frame);
      await wait(Math.max(0, minPlaybackTime - (performance.now() - started)));
      loader.remove();
    });
  })();
</script>
