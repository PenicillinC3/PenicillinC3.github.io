---
// §101 进站加载页（CRT 灰屏 / 像素→清晰 / 真实预取）。
//
// **整套 DOM 由内联脚本自己创建，组件不渲染任何可见标记** —— 这是 §101 修的关键：
// 客户端路由（点站名回首页等）会把目标页 body 换进来，但换入的内联脚本**不执行**，
// 于是被换进来的 `#pl` 标记会以「无动画的灰屏 + 兜底 LOADING 文字」形式卡在屏幕上
// 等 CSS 兜底淡出（实测复现）。不渲染标记 = 换页时根本没有东西可显示。
//
// 另外两道闸：① `document.readyState !== 'loading'` 直接返回（真·首次解析才会是
// loading；换页塞进来的副本此时文档早已 complete）；② sessionStorage `plPlayed`
// 保证一个标签页只播一次。样式仍是内联且**必须排在脚本之前**（脚本要量覆盖层尺寸）。
import { prefetchUrls } from '../lib/prefetch-manifest';

// 清单在构建期算好注入脚本；`<` 转义防 `</script>` 逃逸（CLAUDE.md 坑 2）
const urlsJson = JSON.stringify(await prefetchUrls()).replace(/</g, '\\u003c');

// 注意：下面这段是**拼进 HTML 的 JS 字符串**，内部一律用字符串拼接，
// 不得出现模板字面量或 `${`（会被这里提前求值）。
const bootJs = `
(function () {
  // ① 只在真正的首次解析里播：换页塞进来的副本此刻 readyState 已是 complete
  if (document.readyState !== 'loading') return;
  // ② 一个标签页只播一次
  var KEY = 'plPlayed';
  try {
    if (sessionStorage.getItem(KEY) === '1') return;
    sessionStorage.setItem(KEY, '1');
  } catch (e) { /* 隐私模式：照样播 */ }

  var URLS = ${urlsJson};      // 预取清单（构建期注入）
  var MIN_MS = 5000;           // 要让观众看满的时长（像素→清晰整段铺开）
  var HARD_BAIL_MS = 60000;    // 网络僵死时的唯一逃生口（不想要就设成 Infinity）
  var IDLE_MS = 10000;         // 单个请求「多久没收到字节」算卡死（慢但在动的不会中招）
  var CONC = 5;                // 并发数

  // —— 建 DOM（首帧即它：脚本在 body 最前面同步执行，解析尚未走到可视内容）——
  var el = document.createElement('div');
  el.id = 'pl';
  el.innerHTML =
    '<canvas id="pl-canvas" aria-hidden="true"></canvas>' +
    '<i class="pl-scan" aria-hidden="true"></i>' +      // 扫描线（漂移）
    '<i class="pl-roll" aria-hidden="true"></i>' +      // 回扫亮带
    '<i class="pl-vig" aria-hidden="true"></i>' +       // 多段渐变暗角 + 玻璃高光
    '<p class="pl-fallback" aria-hidden="true">LOADING</p>';
  document.body.appendChild(el);
  document.body.style.overflow = 'hidden';
  window.__pl = { el: el, urls: URLS }; // 验收探针/调试用（无副作用）

  var canvas = el.querySelector('#pl-canvas');
  var ctx = canvas.getContext('2d');
  var reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  var t0 = Date.now();
  var ended = false;

  function done() {
    if (ended) return;
    ended = true;
    el.classList.add('pl-out');
    setTimeout(function () {
      if (el.isConnected) el.remove();
      document.body.style.overflow = '';
    }, 360); // 等收尾动画（白闪 + 灰幕内收）播完再摘
  }

  // ================= 渲染器：像素阶梯 + CRT 管面 =================
  var DPR = Math.min(window.devicePixelRatio || 1, 1.5); // §69：DPR 上限 1.5
  var W = 0, H = 0;
  function resize() {
    // 以覆盖层自身为准（其次文档视口），不是画布 —— 画布 display:none 时
    // clientWidth 会返回 canvas 默认内在宽度 300（§101 实测踩过的坑）
    var cw = el.clientWidth || document.documentElement.clientWidth || innerWidth;
    var ch = el.clientHeight || document.documentElement.clientHeight || innerHeight;
    W = Math.round(cw * DPR);
    H = Math.round(ch * DPR);
    canvas.width = W;
    canvas.height = H;
  }
  resize();
  addEventListener('resize', resize);

  var off = document.createElement('canvas');
  var octx = off.getContext('2d');
  var K = 0.18;      // 曲率：正 = 枕形（四角内收）/ 负 = 桶形（边缘外凸顶到边框）
  var INSET = 0.94;  // 画面整体内缩，露出周围机壳（管面嵌在壳里的立体感）
  var FONT = '"MapleUI Web", "MapleMono Web", ui-monospace, monospace';
  var BLOCK_BIG = 26; // 起步像素块尺寸（设备像素）：越大越糊

  // 块尺寸**阶梯**：内部分辨率只在档位之间跳，不在帧间连续变 —— 连续变会让
  // 字号/字距每帧被 Math.round 重新量化，画面就「抽搐」（§101 用户反馈）。
  // 吸附到档位后：同一档内完全静止，跳档 = 一次干净的分辨率提升。
  var BLOCKS = [26, 21, 17, 13.5, 11, 8.5, 6.5, 5, 3.8, 2.9, 2.2, 1.6, 1];

  function resFor(p) {
    if (reduce) return H;                      // 减动效：直接锐利版
    var t = Math.min(1, Math.max(0, (p - 0.08) / 0.82));
    var want = BLOCK_BIG + (1 - BLOCK_BIG) * Math.pow(t, 0.85);   // 连续目标块尺寸
    var b = 1;
    for (var i = 0; i < BLOCKS.length; i++) { if (want >= BLOCKS[i]) { b = BLOCKS[i]; break; } }
    return H / b;
  }

  // —— 左下角终端文字：先在固定小画布上画，再做 1-bit 阈值化（真像素字），
  //    最后以最近邻贴到**屏幕空间**（不随主分辨率抽搐），位置对齐管面左下角 ——
  var termC = document.createElement('canvas');
  var tctx = termC.getContext('2d');
  var TERM_W = 158, TERM_H = 38;
  var termKey = '';
  function drawTerm() {
    var key = doneCount + '/' + urls.length + '/' + Math.round(received / 262144) + '/' + ended;
    if (key === termKey) return;
    termKey = key;
    termC.width = TERM_W; termC.height = TERM_H;
    tctx.clearRect(0, 0, TERM_W, TERM_H);
    tctx.font = '600 7px ' + FONT;
    tctx.textBaseline = 'top';
    var mb = (received / 1048576).toFixed(1);
    var lines = [
      'PENICILLINC3 // CRT-9000',
      'CACHE ' + doneCount + '/' + urls.length + '   ' + mb + 'MB',
      'SIGNAL ' + (doneCount >= urls.length ? 'READY' : 'SYNCING'),
      'PHOSPHOR P4 MONOCHROME',
    ];
    for (var i = 0; i < lines.length; i++) {
      tctx.fillStyle = i === 0 ? '#ffffff' : '#d8d8d8';
      tctx.fillText(lines[i], 1, 1 + i * 9);
    }
    // 阈值化：抗锯齿的灰边一律削掉 -> 硬边像素字
    try {
      var im = tctx.getImageData(0, 0, TERM_W, TERM_H);
      var d = im.data;
      for (var k = 0; k < d.length; k += 4) {
        if (d[k + 3] > 70) { d[k] = 236; d[k + 1] = 236; d[k + 2] = 236; d[k + 3] = 255; }
        else { d[k + 3] = 0; }
      }
      tctx.putImageData(im, 0, 0);
    } catch (e) { /* 取不到像素就算了，字还是有 */ }
  }

  function drawTermOnScreen() {
    drawTerm();
    var s = Math.max(2, Math.round(H / 300));      // 每个「像素字像素」占几个设备像素
    var dw = TERM_W * s, dh = TERM_H * s;
    var ny = ((H - dh * 0.86) / H) * 2 - 1;
    var sx = reduce ? INSET : (1 - K * ny * ny) * INSET;
    var tubeLeft = (W - W * sx) / 2;               // 贴合变形后的管面左缘
    ctx.imageSmoothingEnabled = false;
    ctx.drawImage(termC, tubeLeft + W * 0.03, H - dh - H * 0.055, dw, dh);
  }

  // —— 荧光柔光：缩到 1/4 模糊后以 lighter 叠回（显像管的光晕）——
  var bloom = document.createElement('canvas');
  var bctx = bloom.getContext('2d');
  function applyBloom() {
    var bw = Math.max(8, Math.round(W / 4)), bh = Math.max(8, Math.round(H / 4));
    if (bloom.width !== bw || bloom.height !== bh) { bloom.width = bw; bloom.height = bh; }
    bctx.setTransform(1, 0, 0, 1, 0, 0);
    bctx.clearRect(0, 0, bw, bh);
    bctx.drawImage(canvas, 0, 0, bw, bh);
    ctx.save();
    ctx.globalCompositeOperation = 'lighter';
    ctx.globalAlpha = 0.26;
    ctx.imageSmoothingEnabled = true;
    try { ctx.filter = 'blur(4px)'; } catch (e) { /* 不支持就少一点柔光 */ }
    ctx.drawImage(bloom, 0, 0, W, H);
    ctx.restore();
  }

  function drawOff(p) {
    var h = Math.max(8, Math.round(resFor(p)));
    var w = Math.max(8, Math.round(h * (W / H)));
    if (off.width !== w || off.height !== h) { off.width = w; off.height = h; }
    var o = octx;
    o.setTransform(1, 0, 0, 1, 0, 0);
    o.fillStyle = '#8c8c8c';   // 荧光屏底色（比外壳亮，衬出管面）
    o.fillRect(0, 0, w, h);

    // —— LOADING（逐字手排字距；字号按画幅宽度收敛，让整词占 62%）——
    var word = 'LOADING';
    var SP_RATIO = 0.24;
    o.textAlign = 'center';
    o.textBaseline = 'middle';
    o.font = '600 100px ' + FONT;
    var at100 = 0, i, cw;
    for (i = 0; i < word.length; i++) at100 += o.measureText(word[i]).width;
    at100 += SP_RATIO * 100 * (word.length - 1);
    var fs = Math.max(3, Math.round((w * 0.62) / at100 * 100));
    o.font = '600 ' + fs + 'px ' + FONT;
    var sp = fs * SP_RATIO, full = 0;
    for (i = 0; i < word.length; i++) full += o.measureText(word[i]).width + sp;
    full -= sp;
    var y = h * 0.44, x0 = w / 2 - full / 2;

    // 红/青微色差：偏移按内部像素折算 ≈2 设备像素，且随清晰度淡入 ——
    // 大色块阶段偏移会跨块变成彩色噪点，故按锐度门控（呼应 §31 的边沿色差）
    var sharp = h / H;
    var fringeA = Math.max(0, (sharp - 0.15) / 0.85) * 0.55;
    if (fringeA > 0.03) {
      var dx = 2 * (h / H) * DPR;
      var cols = ['rgba(255,70,70,' + fringeA.toFixed(2) + ')', 'rgba(70,150,255,' + fringeA.toFixed(2) + ')'];
      for (var c = 0; c < 2; c++) {
        var xc = x0 + (c ? dx : -dx);
        o.fillStyle = cols[c];
        for (i = 0; i < word.length; i++) {
          cw = o.measureText(word[i]).width;
          o.fillText(word[i], xc + cw / 2, y);
          xc += cw + sp;
        }
      }
    }
    o.fillStyle = '#ededed';
    var xw = x0;
    for (i = 0; i < word.length; i++) {
      cw = o.measureText(word[i]).width;
      o.fillText(word[i], xw + cw / 2, y);
      xw += cw + sp;
    }

    // —— 分段格子进度条 ——
    var bars = 20;
    var bw = w * 0.62, bx = (w - bw) / 2;
    var bh = Math.max(2, h * 0.035), by = h * 0.62;
    var gap = (bw / bars) * 0.22;
    var cell = (bw - gap * (bars - 1)) / bars;
    o.fillStyle = 'rgba(255,255,255,0.20)';
    o.fillRect(bx, by, bw, bh);
    o.fillStyle = '#f4f4f4';
    var pc = Math.min(1, Math.max(0, p));
    var lit = Math.round(pc * bars);
    for (i = 0; i < lit; i++) o.fillRect(bx + i * (cell + gap), by, cell, bh);

    // —— 百分比读数（内部字号下限 6px：再小就糊成一块看不出数字）——
    o.font = '600 ' + Math.max(6, Math.round(h * 0.055)) + 'px ' + FONT;
    o.fillStyle = '#e2e2e2';
    o.fillText(Math.round(pc * 100) + '%', w / 2, h * 0.73);
    return h;
  }

  // 上屏：最近邻放大 + 逐行条带变形（水平收缩 ∝ 距中心距离² → 四角内收）
  function blit() {
    ctx.setTransform(1, 0, 0, 1, 0, 0);
    ctx.imageSmoothingEnabled = false;
    ctx.fillStyle = '#242424';   // 外壳/边框（深色，管面外圈）
    ctx.fillRect(0, 0, W, H);
    var strip = Math.max(1, Math.round(2 * DPR));
    for (var y = 0; y < H; y += strip) {
      var ny = ((y + strip / 2) / H) * 2 - 1;
      var sx = reduce ? INSET : (1 - K * ny * ny) * INSET;
      var sy0 = (y / H) * off.height;
      ctx.drawImage(
        off,
        0, sy0, off.width, (strip / H) * off.height,
        (W - W * sx) / 2, y, W * sx, strip
      );
    }
  }

  // ================= 预取引擎：真实字节驱动 =================
  var conn = navigator.connection || {};
  var frugal = !!conn.saveData || /(^|-)2g$/.test(conn.effectiveType || '');
  var urls = URLS.filter(function (u) {
    return !frugal || u.charAt(u.length - 1) === '/';   // 省流量/2G 只取 HTML
  });

  var state = (window.__plState = {
    done: 0, total: urls.length, bytes: 0, frugal: frugal, finished: false,
  });
  var received = 0, seenBytes = 0, seenCount = 0, doneCount = 0;
  var realP = 0, shown = 0;

  function estimate() {
    var avg = seenCount ? seenBytes / seenCount : 20000;
    return seenBytes + (urls.length - seenCount) * avg;
  }
  function addBytes(n) {
    received += n;
    state.bytes = received;
    var total = estimate();
    var p = total > 0 ? Math.min(1, received / total) : 0;
    if (p > realP) realP = p;
  }

  function grab(u) {
    var idle = null, aborted = false;
    function arm(rd) {
      clearTimeout(idle);
      idle = setTimeout(function () {
        aborted = true;
        try { rd.cancel(); } catch (e) {}
      }, IDLE_MS);
    }
    return fetch(u, { priority: 'low', cache: 'force-cache' }).then(function (r) {
      var len = Number(r.headers.get('content-length')) || 0;
      seenCount++;
      seenBytes += len || 12000;
      if (!r.body || !r.body.getReader) {
        return r.arrayBuffer().then(function (b) { addBytes(b.byteLength || len); });
      }
      var rd = r.body.getReader();
      arm(rd);
      function pump() {
        return rd.read().then(function (res) {
          if (res.done) { clearTimeout(idle); return; }
          arm(rd);
          addBytes(res.value ? res.value.length : 0);
          return pump();
        }, function () { clearTimeout(idle); });
      }
      return pump().then(function () { clearTimeout(idle); });
    }).catch(function () { clearTimeout(idle); });
  }

  var idx = 0;
  function worker() {
    if (idx >= urls.length) return Promise.resolve();
    var u = urls[idx++];
    return grab(u).then(function () { state.done = ++doneCount; }).then(worker);
  }
  for (var i = 0; i < CONC && i < urls.length; i++) worker();

  // ================= 帧循环：时间轴主导 + 未下完封顶 99% =================
  // 显示进度 = 时间轴（MIN_MS 内平滑走满），未下完时封顶 99%：
  //   · 资源快 → 10s 内平顺走完，像素→清晰铺满全程
  //   · 10s 到点还没下完 → 停在 99%（像素已到原生分辨率），直到全部到手才补满放行
  // 真实字节进度仍在跑（estimate/done/state 都在用它），只是不再压住显示值 ——
  // 10s 内那根条是给「效果」定节奏的，10s 之后才代表「还在等」。
  function drive() {
    if (ended || !el.isConnected) return;
    var el_ms = Date.now() - t0;
    var tt = Math.min(1, el_ms / MIN_MS);
    var target = tt * tt * (3 - 2 * tt);                   // smoothstep，起步收尾都不突
    if (doneCount < urls.length) target = Math.min(target, 0.99);
    if (target > shown) shown += (target - shown) * 0.12;   // 只升不降
    else if (target < shown) shown = target;
    window.__plReal = shown;

    var p = shown;
    var res = drawOff(p);
    blit();
    drawTermOnScreen();   // 先画一遍：让它参与柔光（有辉光）
    applyBloom();
    drawTermOnScreen();   // 再画一遍：压回锐利的 1-bit 像素字
    window.__plProgress = p;
    window.__plRes = res;
    // 画布出第一帧后才撤掉 DOM 兜底文字（脚本半死时屏幕上一直有东西）
    if (!el.classList.contains('pl-drawn')) el.classList.add('pl-drawn');

    if (doneCount >= urls.length && el_ms >= MIN_MS && shown >= 0.995) {
      state.finished = true;
      window.__plReal = 1;
      drawOff(1);
      blit();
      drawTermOnScreen();
      applyBloom();
      drawTermOnScreen();
      return done();
    }
    if (el_ms >= HARD_BAIL_MS) {                    // 逃生口：网络僵死
      state.finished = true;
      return done();
    }
    requestAnimationFrame(drive);
  }
  requestAnimationFrame(drive);

  // 预加载 MapleUI（画布文字用它；没就绪时前几帧走兜底字链，看不出来）
  try { document.fonts.load('600 40px "MapleUI Web"'); } catch (e) { /* 忽略 */ }
})();
`;
---
<style is:inline>
  /* 兜底：脚本任何异常都不能留下灰屏 —— 14s 后无条件淡出（脚本正常时 5s 内自己收尾） */
  #pl {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: grid;
    place-items: center;
    background: #1c1c1c; /* 机壳（画布铺满后基本被盖住，作兜底底色） */
    animation: pl-failsafe-out 0.5s ease 14s forwards;
  }
  @keyframes pl-failsafe-out { to { opacity: 0; visibility: hidden; } }

  #pl-canvas { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }

  /* —— 扫描线：2px 暗 / 2px 亮（比先前粗一倍），整体缓慢上下漂移 —— */
  .pl-scan {
    position: absolute;
    inset: -4px 0; /* 留出一屏扫描线周期，位移时不露边 */
    pointer-events: none;
    background: repeating-linear-gradient(
      to bottom,
      rgba(0, 0, 0, 0.26) 0 2px,
      rgba(255, 255, 255, 0.035) 2px 4px
    );
    animation: pl-drift 2.6s linear infinite, pl-flicker 0.42s steps(2, end) infinite;
  }
  @keyframes pl-drift { from { transform: translateY(0); } to { transform: translateY(4px); } }
  @keyframes pl-flicker { 0% { opacity: 1; } 50% { opacity: 0.93; } 100% { opacity: 1; } }

  /* —— 回扫亮带：CRT 的 flyback，一条柔亮带缓慢扫过（每轮 7.5s）—— */
  .pl-roll { position: absolute; inset: 0; overflow: hidden; pointer-events: none; }
  .pl-roll::before {
    content: '';
    position: absolute;
    left: 0; right: 0; height: 26%;
    background: linear-gradient(
      to bottom,
      rgba(255, 255, 255, 0) 0%,
      rgba(255, 255, 255, 0.05) 45%,
      rgba(255, 255, 255, 0.075) 50%,
      rgba(255, 255, 255, 0.05) 55%,
      rgba(255, 255, 255, 0) 100%
    );
    animation: pl-roll 7.5s cubic-bezier(0.4, 0, 0.6, 1) infinite;
  }
  @keyframes pl-roll { from { transform: translateY(-30%); } to { transform: translateY(420%); } }

  /* —— 暗角：多段渐变（不是一圈死黑）+ 顶部玻璃高光 + 管面中央微亮 —— */
  .pl-vig {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      linear-gradient(to bottom, rgba(255, 255, 255, 0.055) 0%, rgba(255, 255, 255, 0) 16%),
      radial-gradient(ellipse 62% 48% at 50% 44%, rgba(255, 255, 255, 0.05) 0%, rgba(255, 255, 255, 0) 62%),
      radial-gradient(ellipse 118% 104% at 50% 50%,
        rgba(0, 0, 0, 0) 40%,
        rgba(0, 0, 0, 0.06) 58%,
        rgba(0, 0, 0, 0.18) 74%,
        rgba(0, 0, 0, 0.36) 87%,
        rgba(0, 0, 0, 0.58) 95%,
        rgba(0, 0, 0, 0.74) 100%);
  }

  @media (prefers-reduced-motion: reduce) {
    .pl-scan, .pl-roll::before { animation: none; } /* 静态版：不闪、不漂 */
  }

  /* 收尾：白闪（消磁）→ 灰幕纵向内收（关机塌成一条亮线） */
  @keyframes pl-out {
    0% { filter: brightness(1); }
    14% { filter: brightness(2.8); }
    100% { filter: brightness(0.15); opacity: 0; transform: scaleY(0.004); }
  }
  #pl.pl-out { animation: pl-out 0.34s ease-out forwards; pointer-events: none; }

  #pl.pl-drawn .pl-fallback { display: none; }
  .pl-fallback {
