  // .pl-tr 里还挂着闪动小圆点 <i>，整体覆写会把圆点抹掉。
  function firstTextNode(e) {
    for (var i = 0; i < e.childNodes.length; i++) {
      var n = e.childNodes[i];
      if (n.nodeType === 3 && n.nodeValue.trim()) return n;
    }
    return null;
  }
  // 乱码字**每 FLICKER_MS 才换一次**，不是每帧换。逐帧换等于 60 次/秒，
  // 糊成一片噪点，根本看不出「字在跳」；拉开到 ~80ms 才有逐格翻滚的读感。
  // 用「位置 + 时间刻度」的哈希代替 Math.random：同一刻度内稳定（同一帧内重画不变），
  // 跨刻度才翻新 —— 也就不必给每个字符存 nextAt 之类的状态。
  function flickChar(i, tick) {
    var h = ((i + 1) * 2654435761) ^ ((tick + 1) * 40503);
    h = (h ^ (h >>> 13)) >>> 0;
    h = (h * 1274126177) >>> 0;
    return ORACLE.charAt(h % ORACLE.length);
  }
  // u = 该元素自身的揭示进度（0..1）。第 i 个字在 u >= (i+1)/n 时定形；空格不动。
  // now 传的是**虚拟时间** v —— 闪动也跟着一起压缩，否则揭示加速后字还没跳够就定形了。
  function scramble(s, u, v) {
    var out = '', n = s.length, tick = Math.floor(v / FLICKER_MS);
    for (var i = 0; i < n; i++) {
      var c = s.charAt(i);
