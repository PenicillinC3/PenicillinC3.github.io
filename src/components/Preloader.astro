    finishDecrypt();
    // ⚠ 紧接着必须补一次计数：解密期间 paintCounts() 是被让出去的（decOn 早退），
    //   而它平时只在 drive() 里跑 —— 本函数把 ended 一置位 drive() 就 return 了，
    //   不在这里补，数值列会永远停在标记里的初始值 00 / 00，并被烘进底板。
    paintCounts();
    window.__plPlate = makePlate();         // 烘版面：过渡期球折的就是加载页
    window.__lensScene = 0;                 // 0 = 球里是加载页，1 = 首页场景
    window.__lensBall = true;               // 加载页那颗球上场（首页那颗整体让位）
    window.__lensTransition = true;         // 首页那颗锁视口中心、不跟手（它此刻不可见）
    // 快照：停掉还在跑的 CSS 动画，画面彻底静止。
    // ⚠ 只停 grain 的动画 —— **别再把 scene.style.filter 清成 'none'**：
    //   模糊终点是 BLUR_END(≈0.83px) 而不是 0，清掉等于交班瞬间整页「咔」地变清晰。
    //   主循环在 ended 置位后就不再调 paint()，滤镜本来就停在末值上，不需要额外干预。
    grain.style.animation = 'none';
    // 撤下 DOM 层：屏幕交给 WebGL（底板与刚烘的版面逐像素一致），球的折射才够得着它。
    if (el.isConnected) el.remove();
    document.body.style.overflow = '';

    var scaleFull = BALL_RADIUS_PX * worldPerPx();
    var tA = performance.now();

    (function frame(now) {
      var ms = now - tA;
      // ① 呼出球：由零长到 scaleFull，球心同步后推，底板上的洞按比例跟着长
      var u = smooth(Math.min(1, ms / T_CALL));
      window.__lensScale = scaleFull * u;
      window.__lensZ = CAM_Z - BALL_GAP_W - scaleFull * u * MODEL_R_W;
      window.__lensHolePx = BALL_RADIUS_PX * u * HOLE_RATIO;
      // ② 褪光学：从满强度衰减到中性（ior→1、thickness→0、色差→0）
      var opt = 1;
      if (ms > T_CALL) opt = 1 - smooth(Math.min(1, (ms - T_CALL) / T_FADE));
      window.__lensOptics = opt;
      // ③ 撤场：**球一褪完光学就整颗删掉，没有收回动画**（用户明确要求）。
      //    早先这里还跟着一句 __lensScale = scaleFull * (1 - oo) —— 那是「把球收回去」，
      //    和「加载页的球到点消失、首页的球另外长出来」是两回事，已删。
      //    底板仍旧淡出（__lensScene 驱动它的 opacity）：它不能硬删，
      //    否则会「啪」地跳一下；球本来就已中性、删不删看不出，底板才需要过渡。
      var oo = 0;
      if (ms > T_CALL + T_FADE) {
        window.__lensBall = false;                 // 球：立即退场
        // ⚠ __homeGrow 必须与上一行**同时**置零。首页那颗的可见性只看 __lensBall，
        //   置零晚一步（比如放到 settle 里）中间那 700ms 它就已经可见、而 __homeGrow
        //   还是 undefined（= 满尺寸）—— 屏幕上就是「删完之后首页玻璃球闪一下」。
        window.__homeGrow = 0;
        oo = smooth(Math.min(1, (ms - T_CALL - T_FADE) / T_OUT));
        window.__lensScene = oo;
        // ⚠ 洞**不跟着收**，保持满洞。收了的话底板上「没被挖掉」的面积会重新长回来 ——
        //   等于加载页（左下那个 100）在淡出过程中又冒回来一下（用户实测：百分比闪一下）。
        //   保持满洞 → 底板始终被整块挖空、它的淡出全程无感。
        window.__lensHolePx = BALL_RADIUS_PX * HOLE_RATIO;
      }
      if (ms < T_CALL + T_FADE + T_OUT) { requestAnimationFrame(frame); return; }
      window.__lensHolePx = 0;              // 洞交还（底板此后全透明，有没有洞都一样）
      // 加载页那几个量到此已无人读（首页那颗一个都不读），清掉免得留成陈旧状态
      delete window.__lensScale;
      delete window.__lensOptics;
      delete window.__lensZ;
      settle();
    })(performance.now());

    // ④ 收尾：把球交还给 island 自己管。
    //    HOME_BALL=true → 由零长回首页那颗常态小球（scale 0.10），光学同步恢复；
    //    =false → 直接把球撤掉，首页不留球。
    function settle() {
      // 首页那颗**从首页自己长出来**（不是加载页那颗缩回去）：只推 __homeGrow 0→1，
      // 尺寸由 FluidGlass 用它乘 LENS_PROPS.scale 得到。加载页那几个量一概不碰。
      if (!HOME_BALL) { window.__lensTransition = false; return; }
      window.__lensTransition = false;      // 它就是首页那颗了：正常跟手
      var DUR = 800, tB = performance.now();   // __homeGrow 已在撤场开始时置零
      (function step(now) {
        var k = smooth(Math.min(1, (now - tB) / DUR));
        window.__homeGrow = k;
        if (k < 1) { requestAnimationFrame(step); return; }
        delete window.__homeGrow;           // 交还给 island：此后就是常态那颗球
      })(performance.now());
    }
  }

  // ================= 预取引擎：真实字节驱动 =================
  var conn = navigator.connection || {};
  var frugal = !!conn.saveData || /(^|-)2g$/.test(conn.effectiveType || '');
  var urls = URLS.filter(function (u) {
    return !frugal || u.charAt(u.length - 1) === '/';   // 省流量/2G 只取 HTML
  });

  // 分类：路由 / 字体 / 其余算资源。计数与清单同源 —— 显示出来的永远是**真数**，不是演的。
  function kindOf(u) {
    if (u.charAt(u.length - 1) === '/') return 'route';
    return /\\.woff2$/.test(u) ? 'font' : 'img';
  }
  var totalN = { route: 0, font: 0, img: 0, all: 0 };
  var doneN  = { route: 0, font: 0, img: 0, all: 0 };
  for (var ui = 0; ui < urls.length; ui++) { totalN[kindOf(urls[ui])]++; totalN.all++; }

  var state = (window.__plState = {
    done: 0, total: urls.length, bytes: 0, frugal: frugal, finished: false,
    byKind: totalN,
  });
  var received = 0, seenBytes = 0, seenCount = 0, doneCount = 0;
  var realP = 0, shown = 0;

  function estimate() {
    var avg = seenCount ? seenBytes / seenCount : 20000;
    return seenBytes + (urls.length - seenCount) * avg;
  }
  function addBytes(n) {
    received += n;
    state.bytes = received;
    var total = estimate();
    var p = total > 0 ? Math.min(1, received / total) : 0;
    if (p > realP) realP = p;
  }

  function grab(u) {
    var idle = null, aborted = false;
    function arm(rd) {
      clearTimeout(idle);
      idle = setTimeout(function () {
        aborted = true;
        try { rd.cancel(); } catch (e) {}
      }, IDLE_MS);
    }
    return fetch(u, { priority: 'low', cache: 'force-cache' }).then(function (r) {
      var len = Number(r.headers.get('content-length')) || 0;
      seenCount++;
      seenBytes += len || 12000;
      if (!r.body || !r.body.getReader) {
        return r.arrayBuffer().then(function (b) { addBytes(b.byteLength || len); });
      }
      var rd = r.body.getReader();
      arm(rd);
      function pump() {
        return rd.read().then(function (res) {
          if (res.done) { clearTimeout(idle); return; }
          arm(rd);
          addBytes(res.value ? res.value.length : 0);
          return pump();
        }, function () { clearTimeout(idle); });
      }
      return pump().then(function () { clearTimeout(idle); });
    }).catch(function () { clearTimeout(idle); });
  }

  var idx = 0;
  function worker() {
    if (idx >= urls.length) return Promise.resolve();
    var u = urls[idx++];
    var k = kindOf(u);
    return grab(u).then(function () {
      state.done = ++doneCount;
      doneN[k]++; doneN.all++;
    }).then(worker);
  }
  for (var i = 0; i < CONC && i < urls.length; i++) worker();

  // ================= 渲染 =================
  // 计数补零到目标位数 —— 宽度恒定，标签不会在 9→10 那一刻被顶歪；
  // 也与巨数同一个约定（它是 000→100），整套读数语言一致。
  function pad(v, w) { var t = String(v); while (t.length < w) t = '0' + t; return t; }

  function paintCounts() {
    // 解密期间把这一列让给揭示动画 —— 否则还没定形的乱码会被计数立刻盖掉，
    // 那几格就完全不参与了。（解密一结束本轮全量重写，见 finishDecrypt 清 lastTxt）
    if (decOn) return;
    var wR = String(totalN.route).length;
    var wA = String(totalN.all).length;
    var wF = String(totalN.font).length;
    var t = {
      route: pad(doneN.route, wR) + ' / ' + totalN.route,
      all:   pad(doneN.all, wA)   + ' / ' + totalN.all,
      bytes: (received / 1048576).toFixed(1) + ' MB',
      font:  pad(doneN.font, wF)  + ' / ' + totalN.font
    };
    for (var k in t) {
      if (lastTxt[k] !== t[k] && cells[k]) { cells[k].textContent = t[k]; lastTxt[k] = t[k]; }
    }
  }

  // 渲染一帧。p = 0..1（显示进度，时间轴主导、未就绪时封顶 99%）
  function paint(p) {
    el.style.setProperty('--p', p.toFixed(4));
    if (numEl) numEl.textContent = String(Math.round(p * 100)).padStart(3, '0');

    // 构建网格：竖线自上而下逐一落下（每根错开 0.012 进度、0.10 内长满），
    // 横线自左向右拉开。前 ~16% 进度内建完，之后网格静止。
    for (var i = 0; i < gcols.length; i++) {
      var gh = (p - i * 0.012) / 0.10;
      gcols[i].style.setProperty('--gh', (gh < 0 ? 0 : gh > 1 ? 1 : gh).toFixed(3));
    }
    var rw = p / 0.16;
    el.style.setProperty('--rw', (rw > 1 ? 1 : rw).toFixed(3));

    // 解析：整个场景（网格 / 横线 / 文字 / 加载条）从模糊到清晰。
    // 前 55% 内收干到 BLUR_END，**且是缓入的**（1 − u^POW）：开头几乎不动、末尾猛收，
    // 即「先糊着，快加载完才啪地对上焦」（用户指定）。u² 之下 p=0.3 还剩 5.4px，
    // 到 p=0.5 才跌到 2.2px；线性的话 p=0.3 就只剩 3.0px 了，糊不住。
    // ⚠ 终点是 BLUR_END(≈0.83px) 而不是 0 —— 用户要求 100% 和球出来时保留那一档柔化，
    //   所以永远走 blur()，不再有 filter:none 那一档（代价：末段文字会关掉次像素抗锯齿、
    //   比纯 filter:none 略软 —— 这正是要的效果，别顺手「优化」回去）。
    var u = Math.min(1, p / 0.55);
    var bv = reduce ? 0 : BLUR_END + BLUR_SPAN * (1 - Math.pow(u, BLUR_POW));
    scene.style.filter = bv > 0.02 ? 'blur(' + bv.toFixed(2) + 'px)' : 'none';
    // 灰雾：开场最浓，前 70% 内散尽
    el.style.setProperty('--mist', (reduce ? 0 : Math.max(0, 1 - p / 0.70)).toFixed(3));

    // 颗粒：起点重、终点留一档（不降到 0，留住质感）
    if (grain) grain.style.opacity = reduce ? 0.08 : (0.07 + 0.25 * (1 - p)).toFixed(3);
  }

  // ================= 帧循环：时间轴主导 + 未就绪封顶 99% =================
  function drive() {
    if (ended || !el.isConnected) return;
    var el_ms = Date.now() - t0;
    var tt = Math.min(1, el_ms / MIN_MS);
    var target = tt * tt * (3 - 2 * tt);                 // smoothstep，起步收尾都不突

    // §102：资源没下完、或者玻璃球还没就绪，都压在 99%。
    // 超过 BALL_WAIT_MS 就不再等球（否则窄屏/减动效下会无限停在 99%）。
    var bs = ballState();
    var holdingForBall = bs === 'wait' && el_ms < BALL_WAIT_MS;
    if (doneCount < urls.length || holdingForBall) target = Math.min(target, 0.99);

    if (target > shown) shown += (target - shown) * 0.12; // 只升不降
    else if (target < shown) shown = target;
    window.__plReal = shown;
    window.__plProgress = shown;

    tickDecrypt(performance.now());
    paint(shown);
    paintCounts();
    if (!el.classList.contains('pl-drawn')) el.classList.add('pl-drawn');

    if (doneCount >= urls.length && !holdingForBall && el_ms >= MIN_MS && shown >= 0.995) {
      state.finished = true;
      window.__plReal = 1;
      paint(1);
      paintCounts();
      // §102：球就绪 → 走玻璃球过渡；否则（窄屏 / 减动效 / 等超时）退回原来的淡出
      return bs === 'ready' ? transition() : done();
    }
    if (el_ms >= HARD_BAIL_MS) {                         // 逃生口：网络僵死
      state.finished = true;
      return done();
    }
    requestAnimationFrame(drive);
  }
  paint(0);
  requestAnimationFrame(drive);
})();
`;
