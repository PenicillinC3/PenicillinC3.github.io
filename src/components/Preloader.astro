    }
    return out;
  }
  function startDecrypt() {
    // ⚠ 先把上一轮收尾，再重新抓终值。终值取自**节点当前值**，本函数若在上一轮
    //   中途被再次调用（预览页的滑块、重播都会），抓到的就是乱码 —— 那个乱码
    //   会被当成终值，文字再也回不到真值。真组件只调一次，但这条防线要留住。
    finishDecrypt();
    dec = [];
    var k = 0, t = performance.now();
    var items = el.querySelectorAll('.pl-lbl, .pl-eyebrow, .pl-data span, .pl-data s');
    for (var i = 0; i < items.length; i++) {
      var n = firstTextNode(items[i]);
      if (!n) continue;
      dec.push({ n: n, final: n.nodeValue, off: k * DECRYPT_STAGGER, ms: DECRYPT_MS });
      k++;
    }
    decStart = t;
    decTotal = (k > 0 ? (k - 1) * DECRYPT_STAGGER : 0) + DECRYPT_MS;
    decOn = dec.length > 0;
  }

