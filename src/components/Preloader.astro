  //   前半项 = 用户定的时长 —— 加载够久就按它跑完，手感原样保留；
  //   后半项 = 硬保证 —— 进度到 1 时 v 必到 decTotal，揭示**一定在交班前定格**
  //            （交班条件本身就要求 shown >= 0.995，所以「进度满」与「交班」天然同步）。
  // ⚠ 别改回「预估加载时长、按需加速」那版：真正的瓶颈是等玻璃球就绪（BALL_WAIT_MS
  //   最多 6s），从资源完成度上根本看不出来；估出的期限一收紧就是猛跳，
  //   实测照样有 5 个元素被切。这里不预测任何东西。
  function tickDecrypt(now) {
    if (!decOn) return;
    // 进度项留一成余量（到 90% 就收干）：shown 到 1 的那一刻就是交班，
    // 踩着点定格等于把最后一个元素压在交班那一刻，探针和眼睛都判它「被切」。
    var byProg = Math.min(1, (shown || 0) / 0.9) * decTotal;
    var v = Math.max(now - decStart, byProg);
    var left = 0;
    for (var i = 0; i < dec.length; i++) {
      var d = dec[i], u = (v - d.off) / d.ms;
      if (u < 1) { left++; d.n.nodeValue = scramble(d.final, u, v); }
      else if (d.n.nodeValue !== d.final) d.n.nodeValue = d.final;
    }
    decOn = left > 0;
  }
  // 收尾：把每个节点还原成真字，并清掉 paintCounts 的「上次写过什么」记忆 ——
  // 否则计数列若恰好与记忆值相同就不再重写，屏幕上会留着解密期的乱码。
  function finishDecrypt() {
    for (var i = 0; i < dec.length; i++) dec[i].n.nodeValue = dec[i].final;
    decOn = false;
    lastTxt = {};
  }
  startDecrypt();

  function makePlate() {
    var dpr = Math.min(window.devicePixelRatio || 1, 1.5);
    var CW = innerWidth, CH = innerHeight;
    var c = document.createElement('canvas');
    c.width = Math.round(CW * dpr); c.height = Math.round(CH * dpr);
    var o = c.getContext('2d');
    o.scale(dpr, dpr);
    // ── 几何与文字一律**从活着的 DOM 上量**，不再手写百分比和魔法系数 ──────────
    // 教训：以前按 CSS 的百分比在 canvas 里重算一遍（baseY = boxTop + 0.625*numSize
    // 之类），结果三块文字各错各的 —— 顶部标签高 3px、///LOADING 低 1px、大数字高 11px
    // （探针实测，见 .superpowers/brainstorm/852-.../bisect.mjs）。根因是 canvas 与 CSS
    // 本是三套独立度量（行高 .71 / flex 基线对齐 / textBaseline 'top'），手算的值只要
    // CSS 动一下就重新失配 —— clamp 那次也是同一个病。改成量 DOM 之后 CSS 随便改都不会错。
    // 时机是白拿的：makePlate 只在 transition() 里跑一次，此刻 el 还好端端在屏幕上。
    var q = function (s) { return document.querySelector(s); };
    var qa = function (s) { return document.querySelectorAll(s); };
    var Rc = function (e) { return e ? e.getBoundingClientRect() : null; };

    // 被块化的元素（position:absolute / flex item / grid item 都会块化）rect.top 是
    // **行盒**顶、不是字形顶 → 基线 = 行盒顶 + 半行距 + 上升部。asc/desc 取 canvas 的
    // 字体度量 —— 浏览器给 DOM 排版用的就是同一套表。
    function font(e) {
