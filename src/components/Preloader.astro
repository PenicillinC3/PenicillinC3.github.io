  var BALL_RADIUS_PX = 663;   // 呼出的球半径（屏幕像素）
  var BALL_GAP_W = 0.2;       // 球面停在相机前方的世界距离（球心随尺寸后推，别把相机吞进去）
  var MODEL_R_W = 1.009;      // 模型半径（scale=1 时的世界单位）
  var HOLE_RATIO = 14;        // 底板上的洞 = 球半径 × 此系数
  var CAM_Z = 20, FOV = 15, LENS_Z = 15;      // 与 FluidGlass 一致
  var T_CALL = 1700, T_FADE = 300, T_OUT = 700;   // 呼出 / 褪光学 / 撤场 的时长（ms）
  // 撤场结束后，首页那颗常态小球要不要长回来。
  // ⚠ 加载页的球与首页的球是**两个独立的 mesh**（见 FluidGlass 的 LoadingBall）：
  //   这颗撤走时不会带走首页那颗的任何状态，首页那颗也不读 __lens*。
  //   首页设计里球是主角（§69），所以线上留 true；预览页 dev-ball 是 false。
  var HOME_BALL = true;

  function worldPerPx() {
    return (2 * Math.tan((FOV * Math.PI) / 360) * (CAM_Z - LENS_Z)) / innerHeight;
  }
  function smooth(t) { return t * t * (3 - 2 * t); }

