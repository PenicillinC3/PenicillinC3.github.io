    }

    o.fillStyle = '#f7f7f6'; o.fillRect(0, 0, CW, CH);

    // 交班那层柔化也得烘进底板。DOM 的模糊是 CSS filter 打在 .pl-scene 上的，
    // canvas 不带它的话，撤下 DOM 那一刻整页会「咔」地变清晰 —— 又一处交班跳变
    // （终点改成 BLUR_END≈0.83px 之后才成为问题，以前终点是 0 就无所谓）。
    // 从计算样式直接读，CSS 改多少这里跟多少（reduced-motion 下是 none → 不设）。
    // 只罩场景内容：底板背景和后面的噪点纹都在 .pl-scene 之外，本来就不吃这层模糊。
    var mBlur = /blur\(([\d.]+)px\)/.exec(getComputedStyle(q('.pl-scene')).filter);
    if (mBlur && parseFloat(mBlur[1]) > 0.01) o.filter = 'blur(' + mBlur[1] + 'px)';

    // 竖线：量每一列的左缘，含最后那根 flex:0 的零宽列（它正好压在版心右缘）。
    // 旧代码靠「除以 11 而不是 12」硬凑 —— CSS 一改就废。
    var gbox = Rc(q('.pl-grid')), gis = qa('.pl-grid i');
    if (gbox) {
      o.fillStyle = 'rgba(26,26,26,.09)';
      for (var i = 0; i < gis.length; i++) o.fillRect(Rc(gis[i]).left, gbox.top, 1, gbox.height);
    }
    o.fillStyle = 'rgba(26,26,26,.3)';
    var rt = Rc(q('.pl-rule-t')), rb = Rc(q('.pl-rule-b'));
    if (rt) o.fillRect(rt.left, rt.top, rt.width, 1);     // 上横线只跨 6 栏
    if (rb) o.fillRect(rb.left, rb.top, rb.width, 1);

