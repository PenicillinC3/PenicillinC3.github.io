  if (document.fonts && document.fonts.ready) document.fonts.ready.then(alignData);

  // ── 开场解密揭示（§102）─────────────────────────────────────────────
  // 除百分比外的文字，逐字从乱码**锁定**成真字（左→右），元素之间依次起步。单次。
  // 加载期跑完；transition() 里还会显式收尾一次，保证交班烘进底板的是定格文字。
  // ⚠ 乱码字符集必须落在 MaplePre 子集内（它只切了 A-Z a-z 0-9 与 / . : % ( ) - +）——
  //   用了子集外的字，动画途中会**逐字回退到别的字体**，字形当场变样。
  // ⚠ 这里在 bootJs 模板字符串里：注释中同样不得出现反引号或「美元花括号」。
  //   （写这行时我自己就违反了一次 —— 把那个符号照原样写进注释，构建直接报
  //     esbuild 错、位置指向这一行。要说它，就绕着说。）
  var ORACLE = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789/.:%()-+';
  // ↓ 用户在预览页定的：基础 2000/160 的 2.8 倍，闪动 100ms。
  // ⚠ 整段揭示 = 12×448 + 5600 ≈ 11s，**远超 MIN_MS(5s) 最短加载** ——
  //   所以揭示走的是「虚拟时钟」（见 tickDecrypt）：加载够久就按这个时长原样跑，
  //   不够久则自动跟上进度，保证**永远在交班前定格**，不会被切在半途。
  var DECRYPT_MS = 5600;     // 单个元素内：首字到末字的揭示跨度
  var DECRYPT_STAGGER = 448; // 元素之间依次起步的间隔
  var FLICKER_MS = 100;      // 单个乱码字多久翻一次（小了糊成噪点，大了像卡住）
  var dec = [], decOn = false;
  // 虚拟时钟 v 的起点与总量（v 怎么取见 tickDecrypt）
  var decStart = 0, decTotal = 0;

