---
import { site } from '../site.config';

const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? path === '/' : path.startsWith(href);
---
<header class="topbar" data-topbar>
  <div class="inner">
    <a class="brand" href="/" data-nav-item-home>{site.title}</a>

    <nav class="links" data-nav aria-label="主导航">
      <span class="slider" data-slider aria-hidden="true" transition:persist></span>
      {
        site.nav.map((n) => (
          <a
            class:list={['navlink', isActive(n.href) && 'is-active']}
            data-nav-item
            data-nav-href={n.href}
            href={n.href}
            aria-current={isActive(n.href) ? 'page' : undefined}
          >{n.label}</a>
        ))
      }
    </nav>

    <button class="menu-btn" type="button" data-menu-btn aria-expanded="false" aria-label="展开菜单">
      <span></span><span></span><span></span>
    </button>
  </div>
</header>

{/* §84：抽屉必须放在 .topbar 之外 —— 顶栏的 backdrop-filter（毛玻璃）会创建
     包含块，嵌在其中的 fixed 元素会相对 56px 顶栏定位（高度塌成 0、内容被裁），
     这正是移动端下拉栏「显示不全」的根因 */}
<div class="drawer" data-menu hidden>
  <nav class="drawer-links" aria-label="移动端导航">
    {
      site.nav.map((n) => (
        <a
          class:list={['drawer-link', isActive(n.href) && 'is-active']}
          href={n.href}
          data-drawer-link
        >{n.label}</a>
      ))
    }
  </nav>
</div>

<script>
  // —— 水滴滑块：鼠标跟随（spec §25.1）——
  // 滑块 = 液态水珠：指针在栏目区移动时吸附跟随最近的栏目（指数阻尼 ≈ 参考 demo
  // 的 easing.damp，τ≈90ms），指针离开后滑回当前激活栏目；点击栏目链接才跳页。
  // 垂直居中在 CSS 侧 translateY(-50%)；JS 每帧只写 --sx/width（历史坑：直盖
  // style.transform 会把 -50% 居中挤掉，滑块沿 top:50% 顶边下挂半身）。
  // 换页时序坑（实测）：页面模块脚本换页时不保证重跑、astro:* 事件实际派发在
  // document → 状态挂 window、监听只绑一次 + MutationObserver 兜底，回调自查询
  // 当前文档。触屏/窄屏不启用跟随（抽屉导航）。
  const W = window as unknown as {
    __vibeSlider?: {
      x: number; w: number; tx: number; tw: number;
      restX: number; restW: number;
      hasRest: boolean; over: boolean; init: boolean;
      raf: number; prevT: number;
    };
    __vibeNavBound?: boolean;
  };
  const S = (W.__vibeSlider ??= {
    x: 0, w: 0, tx: 0, tw: 0, restX: 0, restW: 0,
    hasRest: false, over: false, init: false,
    raf: 0, prevT: 0,
  });

  const els = () => ({
    nav: document.querySelector<HTMLElement>('[data-nav]'),
    slider: document.querySelector<HTMLElement>('[data-slider]'),
  });

  // 栏目度量：每次现量（仅 5 个节点；缓存会在字体加载后失效 → 悬停错位，
  // 实测过：不缓存最稳）
  function metrics(): { x: number; w: number }[] {
    const nav = els().nav;
    if (!nav) return [];
    return [...nav.querySelectorAll<HTMLElement>('[data-nav-item]')]
      .map((el) => ({ x: el.offsetLeft, w: el.offsetWidth }))
      .filter((r) => r.w > 0);
  }
  function activeRect(): { x: number; w: number } | null {
    const nav = els().nav;
    const act = nav?.querySelector<HTMLElement>('[data-nav-item].is-active');
    if (!act || act.offsetWidth === 0) return null;
    return { x: act.offsetLeft, w: act.offsetWidth };
  }
  function paint() {
    const { slider } = els();
    if (!slider) return;
    slider.style.setProperty('--sx', `${Math.round(S.x * 100) / 100}px`);
    slider.style.width = `${Math.round(S.w * 100) / 100}px`;
    slider.style.opacity = S.over || S.hasRest ? '1' : '0';
  }
  function tick(t: number) {
    S.raf = 0;
    if (!els().slider) return;
    const dt = Math.min(64, S.prevT ? t - S.prevT : 16);
    S.prevT = t;
    const a = 1 - Math.exp(-dt / 90); // 指数阻尼（≈ easing.damp 手感）
    S.x += (S.tx - S.x) * a;
    S.w += (S.tw - S.w) * a;
    if (Math.abs(S.tx - S.x) < 0.05 && Math.abs(S.tw - S.w) < 0.05) {
      S.x = S.tx;
      S.w = S.tw;
      paint();
      return;
    }
    paint();
    S.raf = requestAnimationFrame(tick);
  }
  function kick() {
    if (!S.raf) {
      S.prevT = 0;
      S.raf = requestAnimationFrame(tick);
    }
  }

  // 刷新「落点」= 当前激活栏目；指针不在栏目区时滑回激活位，无激活则隐藏
  function refreshRest(retry = 0): void {
    const { nav } = els();
    if (!nav) return;
    const ready = [...nav.querySelectorAll<HTMLElement>('[data-nav-item]')]
      .some((el) => el.offsetWidth > 0);
    if (!ready) {
      // 换页瞬间布局未就绪 → 逐帧重试（~16 帧后放弃）
      if (retry < 16) requestAnimationFrame(() => refreshRest(retry + 1));
      return;
    }
    const r = activeRect();
    if (!r) {
      S.hasRest = false;
      if (!S.over) paint();
      return;
    }
    if (!S.init) {
      // 首次落位：直接到激活栏（不播动画）
      S.x = r.x; S.w = r.w; S.tx = r.x; S.tw = r.w;
      S.init = true;
      paint();
      return;
    }
    S.hasRest = true;
    S.restX = r.x;
    S.restW = r.w;
    if (!S.over) {
      S.tx = S.restX;
      S.tw = S.restW;
      kick();
    }
  }

  if (!W.__vibeNavBound) {
    W.__vibeNavBound = true;
    // 指针跟随：鼠标在栏目区 → 吸附最近栏目；离开 → 回激活栏
    document.addEventListener('pointermove', (e) => {
      if (e.pointerType !== 'mouse') return;
      const nav = els().nav;
      if (!nav || !nav.contains(e.target as Node)) {
        if (S.over) {
          S.over = false;
          if (S.hasRest) {
            S.tx = S.restX;
            S.tw = S.restW;
            kick();
          } else {
            paint();
          }
        }
        return;
      }
      const items = metrics();
      if (!items.length) return;
      const px = e.clientX - nav.getBoundingClientRect().left;
      let best = items[0];
      let bd = Infinity;
      for (const it of items) {
        const d = Math.abs(it.x + it.w / 2 - px);
        if (d < bd) { bd = d; best = it; }
      }
      S.over = true;
      S.tx = best.x;
      S.tw = best.w;
      kick();
    });

    // Astro 事件派发在 document（window 双挂保险）；换页后模块脚本不保证重跑 →
    // 再以 MutationObserver 兜底：高亮/布局变动即刷新落点
    const onLoad = () => refreshRest();
    document.addEventListener('astro:page-load', onLoad);
    window.addEventListener('astro:page-load', onLoad);
    let rsT: number | undefined;
    window.addEventListener('resize', () => {
      window.clearTimeout(rsT);
      rsT = window.setTimeout(() => refreshRest(), 150);
    });
    let moT: number | undefined;
    const mo = new MutationObserver(() => {
      window.clearTimeout(moT);
      moT = window.setTimeout(() => refreshRest(), 80);
    });
    mo.observe(document.body, {
      subtree: true,
      childList: true,
      attributes: true,
      attributeFilter: ['class', 'style'],
    });
    // 系统字体首次生效可能改动测量 → 首次布局后校正一次
    try { document.fonts?.ready?.then(() => refreshRest()); } catch { /* 忽略 */ }
  }

  // 模块每次执行：刷新落点（首次含直接落位；VT 场景由上方持久监听兜底）
  refreshRest();

  // —— 移动端抽屉（§85：带展开/收起过渡动画）——
  const menuBtn = document.querySelector<HTMLButtonElement>('[data-menu-btn]');
  const drawer = document.querySelector<HTMLElement>('[data-menu]');
  const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)');
  const setScrollLock = (on: boolean) => {
    document.body.style.overflow = on ? 'hidden' : '';
  };
  const openDrawer = () => {
    if (!drawer) return;
    drawer.hidden = false;
    setScrollLock(true);
    menuBtn?.setAttribute('aria-expanded', 'true');
    // 双 rAF：确保初始态先落一帧，过渡才会真正播放
    requestAnimationFrame(() =>
      requestAnimationFrame(() => drawer.classList.add('is-open')),
    );
  };
  const closeDrawer = (refocus = false) => {
    if (!drawer || drawer.hidden) return;
    setScrollLock(false);
    menuBtn?.setAttribute('aria-expanded', 'false');
    if (refocus) menuBtn?.focus();
    if (reduceMotion.matches) {
      drawer.classList.remove('is-open');
      drawer.hidden = true;
      return;
    }
    drawer.classList.remove('is-open');
    const done = (e: Event) => {
      if (e.target !== drawer) return;
      drawer.hidden = true;
      drawer.removeEventListener('transitionend', done);
    };
    drawer.addEventListener('transitionend', done);
    // 兜底：过渡事件未达（如被 display 中断）时定时收尾
    window.setTimeout(() => {
      if (!drawer.classList.contains('is-open')) drawer.hidden = true;
    }, 320);
  };
  menuBtn?.addEventListener('click', () => {
    if (!drawer) return;
    if (drawer.classList.contains('is-open')) closeDrawer();
    else openDrawer();
  });
  // 点击抽屉内链接：立即收起（随后跳转由 VT 接手），不做等待
  drawer?.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('.drawer-link')) {
      drawer.classList.remove('is-open');
      setScrollLock(false);
    }
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeDrawer(true);
  });
  // 跨断点：抽屉打开时窗口拉宽过 880px → 关闭抽屉并释放滚动锁
  const mq = matchMedia('(min-width: 881px)');
  const onWide = () => {
    if (mq.matches) closeDrawer();
  };
  mq.addEventListener('change', onWide);
</script>

<style>
  /* 固定整条顶栏（spec §14.4） */
  .topbar {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 60;
    height: var(--nav-h);
    /* 导航字体恒为全站 Maple（spec §38）：body.page-dark 会把正文字体切为华文中宋，
       此处显式 var(--font-sans) 让摄影栏目导航与其他栏目一致 */
    font-family: var(--font-sans);
    background: rgba(255, 255, 255, 0.72);
    -webkit-backdrop-filter: blur(14px) saturate(1.6);
    backdrop-filter: blur(14px) saturate(1.6);
    border-bottom: 1px solid var(--glass-border);
  }
  .inner {
    position: relative;
    display: flex;
    align-items: center;
    gap: 4px;
    height: 100%;
    max-width: var(--maxw);
    margin-inline: auto;
    padding-inline: var(--gutter);
  }
  .brand {
    margin-right: 10px;
    font-weight: 800;
    font-size: 1.06rem;
    letter-spacing: 0.02em;
    color: var(--text-1);
    padding: 6px 10px;
    border-radius: var(--radius-s);
    white-space: nowrap;
  }
  .brand:hover { text-decoration: none; color: var(--text-1); }

  .links {
    position: relative;
    display: flex;
    align-items: center;
    gap: 2px;
    height: 100%;
  }
  .navlink {
    position: relative;
    z-index: 1;
    padding: 6px 13px;
    border-radius: var(--radius-s);
    color: var(--text-2);
    font-size: 0.95rem;
    font-weight: 500;
    white-space: nowrap;
    transition: color var(--t-fast) ease-out;
  }
  .navlink:hover { color: var(--text-1); text-decoration: none; }
  .navlink.is-active { color: var(--text-1); font-weight: 650; }

  /* 水滴滑块（spec §25.1/§31）：液态跟随。垂直居中常驻 CSS translateY(-50%)，
     横向位移由 JS 阻尼每帧写 --sx —— 勿加 CSS 位移过渡（会与阻尼打架），
     也勿用 JS 直盖 transform（历史坑：挤掉 -50% 后滑块下挂半身）。
     折射近似：backdrop 微模糊 + 左红/右青色散边缘（接触文字时的色差感） */
  .slider {
    position: absolute;
    top: 50%;
    left: 0;
    height: 34px;
    transform: translate(var(--sx, 0px), -50%);
    border-radius: var(--radius-pill);
    background:
      radial-gradient(130% 70% at 50% 0%, rgba(255, 255, 255, 0.95), rgba(255, 255, 255, 0) 55%),
      rgba(255, 255, 255, 0.62);
    border: 1px solid rgba(15, 23, 42, 0.08);
    box-shadow: var(--glass-shadow);
    -webkit-backdrop-filter: blur(2px) saturate(1.35);
    backdrop-filter: blur(2px) saturate(1.35);
    opacity: 0;
    will-change: transform, width;
    transition: opacity 0.25s ease;
    pointer-events: none;
  }
  /* 色散边缘（spec §31）：接触处模拟折射色差 —— 左缘微红、右缘微青，滤色合成 */
  .slider::before {
    content: "";
    position: absolute;
    inset: -1px;
    border-radius: inherit;
    pointer-events: none;
    background:
      linear-gradient(90deg, rgba(255, 72, 72, 0.22), transparent 7%),
      linear-gradient(270deg, rgba(96, 176, 255, 0.22), transparent 7%);
    mix-blend-mode: screen;
  }

  .menu-btn {
    display: none;
    width: 38px;
    height: 38px;
    border: 0;
    border-radius: var(--radius-s);
    background: transparent;
    color: var(--text-1);
    cursor: pointer;
  }
  .menu-btn span { display: block; width: 18px; height: 2px; margin: 3px auto; background: currentColor; border-radius: 2px; }

  /* 移动端抽屉 */
  .drawer {
    position: fixed;
    inset: var(--nav-h) 0 0 0;
    z-index: 59;
    /* §84：底部叠加 iPhone 安全区，内容不被 Home 指示条盖住 */
    padding: 18px var(--gutter) calc(24px + env(safe-area-inset-bottom));
    background: rgba(255, 255, 255, 0.96);
    overflow-y: auto;
    /* §85：收起态 = 整体回落 + 淡出（is-open 时归位） */
    opacity: 0;
    transform: translateY(-10px);
    visibility: hidden;
    transition:
      opacity 0.22s ease,
      transform 0.26s cubic-bezier(0.22, 0.61, 0.36, 1),
      visibility 0s linear 0.26s;
  }
  .drawer.is-open {
    opacity: 1;
    transform: none;
    visibility: visible;
    transition:
      opacity 0.24s ease,
      transform 0.3s cubic-bezier(0.22, 0.61, 0.36, 1),
      visibility 0s;
  }
  .drawer[hidden] { display: none; }
  /* 逐项上浮淡入（展开时依次进场；收起时统一快速回落，不做逐项延迟） */
  .drawer .drawer-link {
    opacity: 0;
    transform: translateY(8px);
    transition:
      opacity 0.18s ease,
      transform 0.24s cubic-bezier(0.22, 0.61, 0.36, 1);
  }
  .drawer.is-open .drawer-link { opacity: 1; transform: none; }
  .drawer.is-open .drawer-link:nth-child(1) { transition-delay: 0.03s; }
  .drawer.is-open .drawer-link:nth-child(2) { transition-delay: 0.06s; }
  .drawer.is-open .drawer-link:nth-child(3) { transition-delay: 0.09s; }
  .drawer.is-open .drawer-link:nth-child(4) { transition-delay: 0.12s; }
  .drawer.is-open .drawer-link:nth-child(5) { transition-delay: 0.15s; }
  .drawer.is-open .drawer-link:nth-child(6) { transition-delay: 0.18s; }
  @media (prefers-reduced-motion: reduce) {
    .drawer,
    .drawer .drawer-link { transition: none; }
    .drawer .drawer-link { opacity: 1; transform: none; }
  }
  .drawer-links { display: flex; flex-direction: column; gap: 4px; margin-bottom: 18px; }
  .drawer-link {
    padding: 13px 16px;
    border-radius: var(--radius-s);
    color: var(--text-2);
    font-size: 1.02rem;
    font-weight: 550;
  }
  .drawer-link:hover { color: var(--text-1); text-decoration: none; }
  .drawer-link.is-active {
    color: var(--text-1);
    background: radial-gradient(140% 100% at 50% 0%, rgba(255, 255, 255, 0.95), rgba(255, 255, 255, 0.65) 60%);
    border: 1px solid rgba(15, 23, 42, 0.08);
    box-shadow: var(--glass-shadow);
  }

  @media (max-width: 880px) {
    .links { display: none; }
    .menu-btn { display: block; margin-left: auto; }
  }
  @media (min-width: 881px) {
    .drawer { display: none; }
  }
</style>
