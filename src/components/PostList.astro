---
import PostCard from './PostCard.astro';
import type { PostItem } from '../lib/collections';

interface Props {
  items: PostItem[];
  title?: string;
  groupByYear?: boolean;
  filterable?: boolean; // 笔记页标签过滤
}
const { items, groupByYear = false, filterable = false } = Astro.props;
const tags = filterable ? [...new Set(items.flatMap((p) => p.tags))].sort() : [];

const groups = groupByYear
  ? [...new Set(items.map((p) => p.date.slice(0, 4)))].map((y) => ({
      year: y,
      posts: items.filter((p) => p.date.slice(0, 4) === y),
    }))
  : [{ year: '', posts: items }];
---
{
  filterable && tags.length > 1 && (
    <div class="chips" role="group" aria-label="按标签过滤">
      {tags.map((t) => (
        <button type="button" class="chip" data-tag-chip data-tag={t}>{t}</button>
      ))}
    </div>
  )
}
{
  groups.map((g) => (
    <section class="ygroup">
      {groupByYear && <h2 class="yr">{g.year}</h2>}
      <div class="pcols">
        {g.posts.map((p) => <PostCard post={p} />)}
      </div>
    </section>
  ))
}
{
  items.length === 0 && (
    <div class="glass empty">这里还空着 —— 第一篇内容正在路上。</div>
  )
}

<script>
  // —— 笔记标签过滤：快速淡出 + FLIP 平滑上浮 + 分组锁高（spec §54/§55）——
  // 交互模型（§53 占位保留版与 §37 收合版均作废）：点 tag → 不匹配卡 0.2s 快速淡出
  // （期间保留占位，剩余卡不提前乱动）→ 淡完统一 display:none 释放空间 → 剩余卡
  // FLIP 上浮填位。取消/换 tag：回归卡在自身 DOM 位原位淡入，被其挤开的卡同一次
  // FLIP 反向下滑。FLIP = First(记各卡点击时文档坐标) → 一次切 display → Last(重测)
  // → invert(反位 transform 视觉停回原位) → Play(过渡归零)。
  // 锁高（spec §55）：筛选期间把每个分组 .pcols 钉在未筛选态的原高 —— 卡片照旧上浮
  // 聚拢，空出的版面全部沉到分组末尾成留白，页面总高/滚动条/分组位置全程不变
  // （此前反复投诉的「页面缩短」就此消除；余量随取消筛选一并释放还原）。
  // 全程卡片只平移、不形变；连点（动画未完）自动降级直切不排队；reduced-motion 直切。
  const FADE_MS = 200; // 与 GlassCard opacity 0.2s 过渡对齐
  const GLIDE_MS = 300;
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

  let active: string | null = null;
  let busyUntil = 0; // 上一轮动画预算结束时刻：未结束又点击 → 本轮直切
  let timer = 0;
  const hidden = new Set<HTMLElement>(); // 已 display:none 离场的卡片
  const locks = new Map<HTMLElement, number>(); // 分组 .pcols → 未筛选态原高（筛选期锁高用）

  const owns = (art: HTMLElement, tag: string | null) =>
    !tag || (art.dataset.tags ?? '').split(' ').filter(Boolean).includes(tag);
  const cards = () =>
    [...document.querySelectorAll<HTMLElement>('[data-tags]')]
      .map((a) => a.closest<HTMLElement>('.glasscard'))
      .filter((w): w is HTMLElement => !!w);
  // 文档坐标：淡出等待期间用户滚动也不影响 FLIP 差值
  const docTop = (el: HTMLElement) => el.getBoundingClientRect().top + window.scrollY;
  const groups = () => [...document.querySelectorAll<HTMLElement>('.pcols')];

  const refresh = () => {
    window.clearTimeout(timer);
    const now = performance.now();
    const anim = !reduced && now >= busyUntil;
    busyUntil = now + (anim ? FADE_MS + GLIDE_MS + 120 : 120);

    // 进入筛选态且尚未锁高 → 量取各分组的未筛选原高（此刻布局即未筛选布局）
    if (active && locks.size === 0) {
      groups().forEach((g) => { if (g.offsetHeight > 0) locks.set(g, g.offsetHeight); });
    }

    // FLIP First：当前布局快照（本轮要淡出的卡仍在列，最后会被隐藏集排除；
    // 回归卡此前离场无旧位可滑 → 只淡入）
    const prev = anim ? new Map<HTMLElement, number>() : null;
    if (prev) cards().forEach((w) => { if (!hidden.has(w)) prev.set(w, docTop(w)); });

    // 阶段 A：仅透明切换 —— 淡出卡仍占位、回归卡仍离场，布局零变化
    if (anim) {
      cards().forEach((w) => {
        const art = w.querySelector<HTMLElement>('[data-tags]');
        const show = !!art && owns(art, active);
        if (!show && !hidden.has(w)) w.classList.add('is-out');
      });
    }

    const finish = () => {
      // 阶段 B：一次性切换布局 —— 离场卡出流（display:none），回归卡回流（从透明起步）；
      // 同一趟布局里上锁/解锁分组高度（离场释放与锁高同时生效 → 无「先缩短再撑回」的闪跳）
      if (active) locks.forEach((h, g) => { g.style.minHeight = `${h}px`; });
      else { locks.forEach((_, g) => { g.style.minHeight = ''; }); locks.clear(); }
      cards().forEach((w) => {
        const art = w.querySelector<HTMLElement>('[data-tags]');
        const show = !!art && owns(art, active);
        if (!show) {
          w.classList.remove('is-out');
          w.style.display = 'none';
          hidden.add(w);
        } else if (hidden.has(w)) {
          hidden.delete(w);
          w.classList.add('is-out'); // 回归从 opacity:0 起步，Play 段去类淡入
          w.style.display = '';
        }
      });
      // invert：仍可见且布局位有变的卡，反位移回旧位（视觉停在原地等滑行）
      const glideEls: HTMLElement[] = [];
      if (prev) {
        cards().forEach((w) => {
          if (hidden.has(w) || !prev.has(w)) return;
          const d = prev.get(w)! - docTop(w);
          if (Math.abs(d) < 0.5) return;
          w.style.transform = `translateY(${d}px)`;
          glideEls.push(w);
        });
        void document.body.offsetHeight; // 统一回流：让反位 transform 落地
      }
      // Play：反位卡过渡归零 = 滑向新位；回归卡去 is-out = 原位淡入
      glideEls.forEach((w) => {
        w.style.transition = `transform ${GLIDE_MS}ms cubic-bezier(0.22, 1, 0.36, 1)`; // 上浮缓出
        w.style.transform = '';
      });
      cards().forEach((w) => {
        if (!hidden.has(w)) w.classList.remove('is-out');
      });
      if (glideEls.length) {
        window.setTimeout(() => {
          glideEls.forEach((w) => { w.style.transition = ''; }); // 还权 CSS（hover raise 过渡）
        }, GLIDE_MS + 80);
      }
    };
    if (anim) timer = window.setTimeout(finish, FADE_MS);
    else finish();

    // 芯片激活态即时同步
    document.querySelectorAll<HTMLButtonElement>('[data-tag-chip]').forEach((ch) => {
      const on = ch.dataset.tag === active;
      ch.classList.toggle('on', on);
      ch.setAttribute('aria-pressed', String(on));
    });
  };

  document.addEventListener('click', (e) => {
    const t = (e.target as HTMLElement).closest('[data-tag-chip]') as HTMLButtonElement | null;
    if (!t) return;
    const tag = t.dataset.tag ?? null;
    active = active === tag ? null : tag;
    refresh();
  });
</script>

<style>
  .chips { display: flex; flex-wrap: wrap; gap: 8px; margin: 0 0 22px; }
  .chip {
    border: 1px solid var(--glass-border);
    background: linear-gradient(180deg, var(--glass-hl), transparent 40%), var(--glass-bg);
    -webkit-backdrop-filter: blur(var(--glass-blur)) saturate(var(--glass-sat));
    backdrop-filter: blur(var(--glass-blur)) saturate(var(--glass-sat));
    color: var(--text-2);
    border-radius: var(--radius-pill);
    padding: 0.32em 1em;
    font-size: 0.85rem;
    cursor: pointer;
    transition: color 0.15s ease-out, box-shadow 0.15s ease-out;
  }
  .chip:hover { color: var(--text-1); }
  .chip.on {
    color: var(--text-1);
    box-shadow: inset 0 0 0 1.5px var(--accent);
  }
  .ygroup { margin-bottom: clamp(28px, 5vw, 44px); }
  .yr { font-size: 1rem; color: var(--text-3); font-weight: 600; margin: 0 0 12px; }
  .pcols {
    display: grid;
    grid-template-columns: minmax(0, 1fr); /* 单列通栏大卡（spec §24；§21.4 双栏作废） */
    gap: clamp(18px, 2.4vw, 28px);
  }
  .empty { padding: clamp(28px, 6vw, 60px); text-align: center; color: var(--text-2); }
</style>
