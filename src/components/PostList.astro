---
import PostCard from './PostCard.astro';
import type { PostItem } from '../lib/collections';

interface Props {
  items: PostItem[];
  title?: string;
  groupByYear?: boolean;
  filterable?: boolean; // 笔记页标签过滤
}
const { items, groupByYear = false, filterable = false } = Astro.props;
const tags = filterable ? [...new Set(items.flatMap((p) => p.tags))].sort() : [];

const groups = groupByYear
  ? [...new Set(items.map((p) => p.date.slice(0, 4)))].map((y) => ({
      year: y,
      posts: items.filter((p) => p.date.slice(0, 4) === y),
    }))
  : [{ year: '', posts: items }];
---
{
  filterable && tags.length > 1 && (
    <div class="chips" role="group" aria-label="按标签过滤">
      {tags.map((t) => (
        <button type="button" class="chip" data-tag-chip data-tag={t}>{t}</button>
      ))}
    </div>
  )
}
{
  groups.map((g) => (
    <section class="ygroup">
      {groupByYear && <h2 class="yr">{g.year}</h2>}
      <div class="pcols">
        {g.posts.map((p) => <PostCard post={p} />)}
      </div>
    </section>
  ))
}
{
  items.length === 0 && (
    <div class="glass empty">这里还空着 —— 第一篇内容正在路上。</div>
  )
}

<script>
  // 标签过滤（事件委托，防 View Transitions 重渲染/脚本顺序问题）：
  // 两段式显隐（spec §37）：不匹配卡片先原位淡出（.glasscard.is-out，0.2s，
  // GlassCard.astro 提供 opacity/pointer-events 规则），淡出结束后整批从文档流
  // 收合（display:none），空年份组随之下沉隐藏 —— 不做瞬时塌缩跳页；
  // 重新匹配的卡片先恢复文档流、从透明淡入。每次操作递增世代号，作废上一批
  // 未到期的折叠定时器，快速连点 chip 时中间态不互相踩踏。
  let active: string | null = null;
  let gen = 0;
  const FADE = 200;

  const cards = () =>
    [...document.querySelectorAll<HTMLElement>('[data-tags]')]
      .map((el) => el.closest<HTMLElement>('.glasscard'))
      .filter((w): w is HTMLElement => !!w);

  const syncGroups = () => {
    document.querySelectorAll<HTMLElement>('.ygroup').forEach((g) => {
      const anyVisible = [...g.querySelectorAll<HTMLElement>('.glasscard')]
        .some((c) => c.style.display !== 'none');
      g.style.display = anyVisible ? '' : 'none';
    });
  };

  const refresh = () => {
    const my = ++gen;
    const fadeIn: HTMLElement[] = [];
    cards().forEach((w) => {
      const own = ((w.querySelector('[data-tags]') as HTMLElement | null)?.dataset.tags ?? '')
        .split(' ')
        .filter(Boolean);
      const show = !active || own.includes(active);
      const hidden = w.style.display === 'none';
      const out = w.classList.contains('is-out');
      if (show) {
        if (out) w.classList.remove('is-out'); // 正在淡出 → 取消并淡回
        if (hidden) {
          w.style.display = '';
          const g = w.closest<HTMLElement>('.ygroup');
          if (g) g.style.display = '';
          w.classList.add('is-out'); // 从透明起步
          fadeIn.push(w);
        }
      } else if (!out) {
        w.classList.add('is-out'); // 原地淡出
      }
    });
    if (fadeIn.length) {
      requestAnimationFrame(() =>
        requestAnimationFrame(() =>
          fadeIn.forEach((w) => w.classList.remove('is-out')),
        ),
      );
    }
    // 淡出收合：整批在淡出完成后统一移出文档流（期间若有新操作则本批作废）
    window.setTimeout(() => {
      if (my !== gen) return;
      cards().forEach((w) => {
        if (w.classList.contains('is-out') && w.style.display !== 'none') {
          w.classList.remove('is-out');
          w.style.display = 'none';
        }
      });
      syncGroups();
    }, FADE + 30);
    // chip 激活态即时同步
    document.querySelectorAll<HTMLButtonElement>('[data-tag-chip]').forEach((ch) => {
      const on = ch.dataset.tag === active;
      ch.classList.toggle('on', on);
      ch.setAttribute('aria-pressed', String(on));
    });
  };

  document.addEventListener('click', (e) => {
    const t = (e.target as HTMLElement).closest('[data-tag-chip]') as HTMLButtonElement | null;
    if (!t) return;
    const tag = t.dataset.tag ?? null;
    active = active === tag ? null : tag;
    refresh();
  });
</script>

<style>
  .chips { display: flex; flex-wrap: wrap; gap: 8px; margin: 0 0 22px; }
  .chip {
    border: 1px solid var(--glass-border);
    background: linear-gradient(180deg, var(--glass-hl), transparent 40%), var(--glass-bg);
    -webkit-backdrop-filter: blur(var(--glass-blur)) saturate(var(--glass-sat));
    backdrop-filter: blur(var(--glass-blur)) saturate(var(--glass-sat));
    color: var(--text-2);
    border-radius: var(--radius-pill);
    padding: 0.32em 1em;
    font-size: 0.85rem;
    cursor: pointer;
    transition: color 0.15s ease-out, box-shadow 0.15s ease-out;
  }
  .chip:hover { color: var(--text-1); }
  .chip.on {
    color: var(--text-1);
    box-shadow: inset 0 0 0 1.5px var(--accent);
  }
  .ygroup { margin-bottom: clamp(28px, 5vw, 44px); }
  .yr { font-size: 1rem; color: var(--text-3); font-weight: 600; margin: 0 0 12px; }
  .pcols {
    display: grid;
    grid-template-columns: minmax(0, 1fr); /* 单列通栏大卡（spec §24；§21.4 双栏作废） */
    gap: clamp(18px, 2.4vw, 28px);
  }
  .empty { padding: clamp(28px, 6vw, 60px); text-align: center; color: var(--text-2); }
</style>
