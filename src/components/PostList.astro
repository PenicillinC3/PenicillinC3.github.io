---
import PostCard from './PostCard.astro';
import type { PostItem } from '../lib/collections';

interface Props {
  items: PostItem[];
  title?: string;
  groupByYear?: boolean;
  filterable?: boolean; // 笔记页标签过滤
}
const { items, groupByYear = false, filterable = false } = Astro.props;
const tags = filterable ? [...new Set(items.flatMap((p) => p.tags))].sort() : [];

const groups = groupByYear
  ? [...new Set(items.map((p) => p.date.slice(0, 4)))].map((y) => ({
      year: y,
      posts: items.filter((p) => p.date.slice(0, 4) === y),
    }))
  : [{ year: '', posts: items }];
---
{
  filterable && tags.length > 1 && (
    <div class="chips" role="group" aria-label="按标签过滤">
      {tags.map((t) => (
        <button type="button" class="chip" data-tag-chip data-tag={t}>{t}</button>
      ))}
    </div>
  )
}
{
  groups.map((g) => (
    <section class="ygroup">
      {groupByYear && <h2 class="yr">{g.year}</h2>}
      <div class="pcols">
        {g.posts.map((p) => <PostCard post={p} />)}
      </div>
    </section>
  ))
}
{
  items.length === 0 && (
    <div class="glass empty">这里还空着 —— 第一篇内容正在路上。</div>
  )
}

<script>
  // 标签过滤（事件委托，防 View Transitions 重渲染/脚本顺序问题）：
  // 原位淡出 + 占位保留（spec §53，§37 的收合方案作废）：不匹配卡片加
  // .glasscard.is-out —— opacity 0.2s 淡出、visibility 延迟隐藏 —— 但始终
  // 留在文档流中占位，页面高度/卡片位置/滚动条全程不变，不再塌缩跳动。
  // 重新匹配即移除 is-out：visibility 立即恢复、opacity 淡回（GlassCard
  // 两侧 transition 规则分别处理延迟方向）。
  let active: string | null = null;

  const refresh = () => {
    document.querySelectorAll<HTMLElement>('[data-tags]').forEach((art) => {
      const w = art.closest<HTMLElement>('.glasscard');
      if (!w) return;
      const own = (art.dataset.tags ?? '').split(' ').filter(Boolean);
      const show = !active || own.includes(active);
      w.classList.toggle('is-out', !show);
    });
    // chip 激活态即时同步
    document.querySelectorAll<HTMLButtonElement>('[data-tag-chip]').forEach((ch) => {
      const on = ch.dataset.tag === active;
      ch.classList.toggle('on', on);
      ch.setAttribute('aria-pressed', String(on));
    });
  };

  document.addEventListener('click', (e) => {
    const t = (e.target as HTMLElement).closest('[data-tag-chip]') as HTMLButtonElement | null;
    if (!t) return;
    const tag = t.dataset.tag ?? null;
    active = active === tag ? null : tag;
    refresh();
  });
</script>

<style>
  .chips { display: flex; flex-wrap: wrap; gap: 8px; margin: 0 0 22px; }
  .chip {
    border: 1px solid var(--glass-border);
    background: linear-gradient(180deg, var(--glass-hl), transparent 40%), var(--glass-bg);
    -webkit-backdrop-filter: blur(var(--glass-blur)) saturate(var(--glass-sat));
    backdrop-filter: blur(var(--glass-blur)) saturate(var(--glass-sat));
    color: var(--text-2);
    border-radius: var(--radius-pill);
    padding: 0.32em 1em;
    font-size: 0.85rem;
    cursor: pointer;
    transition: color 0.15s ease-out, box-shadow 0.15s ease-out;
  }
  .chip:hover { color: var(--text-1); }
  .chip.on {
    color: var(--text-1);
    box-shadow: inset 0 0 0 1.5px var(--accent);
  }
  .ygroup { margin-bottom: clamp(28px, 5vw, 44px); }
  .yr { font-size: 1rem; color: var(--text-3); font-weight: 600; margin: 0 0 12px; }
  .pcols {
    display: grid;
    grid-template-columns: minmax(0, 1fr); /* 单列通栏大卡（spec §24；§21.4 双栏作废） */
    gap: clamp(18px, 2.4vw, 28px);
  }
  .empty { padding: clamp(28px, 6vw, 60px); text-align: center; color: var(--text-2); }
</style>
