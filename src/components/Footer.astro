---
import { site } from '../site.config';
---
<footer class="foot">
  <div class="wrap">
    <div class="glass inner">
      <p class="note">{site.footerNote}</p>
      <p class="copy">
        © <span data-year>2026</span> {site.title}
        <span class="dot">·</span>
        <a href="/">回到首页</a>
      </p>
    </div>
  </div>
</footer>

<script>
  const el = document.querySelector('[data-year]');
  if (el) el.textContent = String(new Date().getFullYear());
</script>

<style>
  .foot {
    padding: 0 var(--gutter) clamp(16px, 3vw, 28px);
  }
  .inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 4px 24px;
    padding: 14px clamp(18px, 3vw, 28px);
    border-radius: var(--radius-lg);
  }
  .note { margin: 0; font-size: 0.85rem; color: var(--text-2); }
  .copy { margin: 0; font-size: 0.85rem; color: var(--text-3); }
  .copy a { color: var(--text-3); }
  .dot { padding: 0 8px; }
</style>
