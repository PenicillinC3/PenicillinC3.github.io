---
import { site } from '../site.config';
---
<!-- spec §33：页脚仅首页渲染（Base 按路径裁剪），右侧回到首页已删 -->
<footer class="foot">
  <div class="wrap">
    <div class="glass inner">
      <p class="note">{site.footerNote}</p>
      <p class="copy">© <span data-year>2026</span> {site.title} Via Claude Code</p>
    </div>
  </div>
</footer>

<script>
  const el = document.querySelector('[data-year]');
  if (el) el.textContent = String(new Date().getFullYear());
</script>

<style>
  .foot {
    padding: 0 var(--gutter) clamp(16px, 3vw, 28px);
  }
  .inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 4px 24px;
    padding: 14px clamp(18px, 3vw, 28px);
    border-radius: var(--radius-lg);
  }
  .note { margin: 0; font-size: 0.85rem; color: var(--text-2); }
  /* §91：去掉 nowrap —— 窄屏/系统大字下版权行（36 字符）比卡片还宽，
     会溢出撑破页面「揉成一坨」；窄屏改为纵向堆叠、两行都能自然换行 */
  .copy { margin: 0; font-size: 0.85rem; color: var(--text-3); }
  @media (max-width: 560px) {
    .inner {
      flex-direction: column;
      align-items: flex-start;
      gap: 6px;
    }
  }
</style>
