---
import GlassCard from './GlassCard.astro';
import Pill from './Pill.astro';
import { formatDate } from '../lib/date';
import type { LinkItem } from '../lib/collections';

interface Props { link: LinkItem }
const { link } = Astro.props;
const initial = link.host.charAt(0).toUpperCase();
---
<GlassCard hover>
  <article class="lcard">
    <div class="top">
      <div class="row">
        <span class="fav" aria-hidden="true">{initial}</span>
        <div class="ids">
          <h3 class="lt"><a href={link.url} target="_blank" rel="noopener noreferrer">{link.title}</a></h3>
          <p class="host">{link.host}</p>
        </div>
      </div>
      <p class="lm">{formatDate(link.date)} · 收藏</p>
    </div>
    {link.note && <p class="ln">{link.note}</p>}
    {link.tags.length > 0 && (
      <div class="ltags">
        {link.tags.map((t) => <Pill text={t} />)}
      </div>
    )}
  </article>
</GlassCard>

<style>
  /* 单列通栏大卡（spec §24）：图标+标题居左、日期居右，说明限宽；
     基准高/内边距与 PostCard 完全一致（三栏目卡片对齐，spec §25.3） */
  .lcard {
    position: relative; /* 整卡可点：标题链接 ::after 拉伸铺满全卡 */
    display: flex;
    flex-direction: column;
    gap: 14px;
    min-height: 230px;
    padding: clamp(24px, 3.4vw, 38px) clamp(24px, 4vw, 52px);
    height: 100%;
    cursor: pointer;
  }
  .lcard:hover { text-decoration: none; }
  .top { display: flex; align-items: flex-start; justify-content: space-between; gap: 14px 22px; }
  .row { display: flex; align-items: center; gap: 16px; margin: 0; min-width: 0; }
  .fav {
    flex: none;
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border-radius: 15px;
    font-weight: 500;
    font-size: 1.2rem;
    color: #fff;
    background: linear-gradient(135deg, var(--accent), color-mix(in srgb, var(--accent) 45%, #b26be0));
    box-shadow: 0 6px 18px color-mix(in srgb, var(--accent) 35%, transparent);
  }
  .ids { min-width: 0; }
  .lt { margin: 0; font-size: clamp(1.2rem, 1.5vw, 1.4rem); }
  .lt a { color: var(--text-1); }
  /* 标题悬停：只变色、不下划线 */
  .lt a:hover { color: var(--accent); text-decoration: none; }
  .lt a::after {
    content: "";
    position: absolute;
    inset: 0; /* 铺满 .lcard → 整卡可点（外链新标签打开） */
  }
  .host { margin: 3px 0 0; font-size: 0.82rem; color: var(--text-3); font-family: var(--font-mono); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .lm { margin: 6px 0 0; font-size: 0.82rem; color: var(--text-3); white-space: nowrap; }
  .ln { margin: 0; max-width: min(100%, 76ch); color: var(--text-2); font-size: 1.02rem; line-height: 1.8; }
  .ltags { display: flex; flex-wrap: wrap; gap: 7px; margin-top: auto; }
</style>
