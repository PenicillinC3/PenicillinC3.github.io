---
// 红色射线氛围层（spec §26）：SideRays（react-bits / DavidHDev）的 ogl WebGL
// 移植版 —— 去掉 react 壳，纯 Astro + ogl，着色器逐行保留原作。
// 用法（variant）：
//   overlay  —— /photos 首页：滤色叠在照片/齿孔带之上（全视口 fixed，z 58，
//               低于顶栏 60，高于舞台内容），照片区与黑场同时泛红光；
//   backdrop —— 卷备忘页等暗色正文背景：fixed z -1，玻璃卡后方透出射线。
import type { RaysConfig } from '../lib/rays-config';

interface Props {
  variant?: 'overlay' | 'backdrop';
  config?: Partial<RaysConfig>;
}

const DEFAULTS: RaysConfig = {
  speed: 2.5,
  rayColor1: '#ff0000',
  rayColor2: '#ffffff',
  intensity: 1.7,
  spread: 2,
  origin: 'top-right',
  tilt: 0,
  saturation: 1.5,
  blend: 0.75,
  falloff: 1.6,
  opacity: 1,
};
const { variant = 'backdrop', config } = Astro.props;
const cfg = JSON.stringify({ ...DEFAULTS, ...config }).replace(/</g, '\\u003c');
const vc =
  variant === 'overlay'
    ? 'rays rays--overlay'
    : variant === 'navstrip'
      ? 'rays rays--navstrip'
      : 'rays rays--backdrop';
---
<div class={vc} data-rays aria-hidden="true"></div>
<script is:inline type="application/json" data-rays-cfg set:html={cfg}></script>

<script>
  import { Mesh, Program, Renderer, Triangle } from 'ogl';

  // §70-2：一页多实例（画廊页 = arena overlay + 导航条带 nav）。模块每页只执行
  // 一次 → 遍历全部 [data-rays] 各自绑定（原 querySelector 只绑第一个，nav 实例
  // 被 data.ready 跳过、画布缺失）
  const bindRays = (holder: HTMLElement | null, cfgEl: Element | null) => {
    if (!holder || !cfgEl || holder.dataset.ready) return;
    holder.dataset.ready = '1';
    const cfg = JSON.parse((cfgEl as HTMLScriptElement).textContent ?? '{}') as {
      speed: number; rayColor1: string; rayColor2: string; intensity: number;
      spread: number; origin: string; tilt: number; saturation: number;
      blend: number; falloff: number; opacity: number;
    };

    const hexToRgb = (hex: string): [number, number, number] => {
      const m = /^#?([a-f\d]{2})([a-f\d]{2})([a-f\d]{2})$/i.exec(hex);
      return m
        ? [parseInt(m[1], 16) / 255, parseInt(m[2], 16) / 255, parseInt(m[3], 16) / 255]
        : [1, 1, 1];
    };
    const [flipX, flipY] = cfg.origin === 'top-left' ? [1, 0]
      : cfg.origin === 'bottom-right' ? [0, 1]
      : cfg.origin === 'bottom-left' ? [1, 1]
      : [0, 0];

    // —— 原作着色器（逐行保留）——
    const vert = `
attribute vec2 position;
void main() {
  gl_Position = vec4(position, 0.0, 1.0);
}`;
    const frag = `precision highp float;

uniform float iTime;
uniform vec2 iResolution;
uniform float iSpeed;
uniform vec3 iRayColor1;
uniform vec3 iRayColor2;
uniform float iIntensity;
uniform float iSpread;
uniform float iFlipX;
uniform float iFlipY;
uniform float iTilt;
uniform float iSaturation;
uniform float iBlend;
uniform float iFalloff;
uniform float iOpacity;

float rayStrength(vec2 raySource, vec2 rayRefDirection, vec2 coord, float seedA, float seedB, float speed) {
  vec2 sourceToCoord = coord - raySource;
  float cosAngle = dot(normalize(sourceToCoord), rayRefDirection);
  return clamp(
    (0.45 + 0.15 * sin(cosAngle * seedA + iTime * speed)) +
    (0.3 + 0.2 * cos(-cosAngle * seedB + iTime * speed)),
    0.0, 1.0) *
    clamp((iResolution.x - length(sourceToCoord)) / iResolution.x, 0.5, 1.0);
}

void main() {
  vec2 fragCoord = gl_FragCoord.xy;
  if (iFlipX > 0.5) fragCoord.x = iResolution.x - fragCoord.x;
  if (iFlipY > 0.5) fragCoord.y = iResolution.y - fragCoord.y;

  vec2 coord = vec2(fragCoord.x, iResolution.y - fragCoord.y);
  vec2 rayPos = vec2(iResolution.x * 1.1, -0.5 * iResolution.y);

  float tiltRad = iTilt * 3.14159265 / 180.0;
  float cs = cos(tiltRad);
  float sn = sin(tiltRad);
  vec2 rel = coord - rayPos;
  vec2 tiltedCoord = vec2(rel.x * cs - rel.y * sn, rel.x * sn + rel.y * cs) + rayPos;

  float halfSpread = iSpread * 0.275;
  vec2 rayRefDir1 = normalize(vec2(cos(0.785398 + halfSpread), sin(0.785398 + halfSpread)));
  vec2 rayRefDir2 = normalize(vec2(cos(0.785398 - halfSpread), sin(0.785398 - halfSpread)));

  vec4 rays1 = vec4(iRayColor1, 1.0) * rayStrength(rayPos, rayRefDir1, tiltedCoord, 36.2214, 21.11349, iSpeed);
  vec4 rays2 = vec4(iRayColor2, 1.0) * rayStrength(rayPos, rayRefDir2, tiltedCoord, 22.3991, 18.0234, iSpeed * 0.2);

  vec4 color = rays1 * (1.0 - iBlend) * 0.9 + rays2 * iBlend * 0.9;

  float distanceToLight = length(fragCoord.xy - vec2(rayPos.x, iResolution.y - rayPos.y)) / iResolution.y;
  float brightness = iIntensity * 0.4 / pow(max(distanceToLight, 0.001), iFalloff);
  color.rgb *= brightness;

  float gray = dot(color.rgb, vec3(0.299, 0.587, 0.114));
  color.rgb = mix(vec3(gray), color.rgb, iSaturation);

  color.a = max(color.r, max(color.g, color.b)) * iOpacity;
  gl_FragColor = color;
}`;

    const renderer = new Renderer({ dpr: Math.min(window.devicePixelRatio, 2), alpha: true });
    const gl = renderer.gl;
    gl.canvas.style.width = '100%';
    gl.canvas.style.height = '100%';
    holder.appendChild(gl.canvas);

    const uniforms = {
      iTime: { value: 0 },
      iResolution: { value: [1, 1] as number[] },
      iSpeed: { value: cfg.speed },
      iRayColor1: { value: hexToRgb(cfg.rayColor1) as number[] },
      iRayColor2: { value: hexToRgb(cfg.rayColor2) as number[] },
      iIntensity: { value: cfg.intensity },
      iSpread: { value: cfg.spread },
      iFlipX: { value: flipX },
      iFlipY: { value: flipY },
      iTilt: { value: cfg.tilt },
      iSaturation: { value: cfg.saturation },
      iBlend: { value: cfg.blend },
      iFalloff: { value: cfg.falloff },
      iOpacity: { value: cfg.opacity },
    };
    const geometry = new Triangle(gl);
    const program = new Program(gl, { vertex: vert, fragment: frag, uniforms });
    const mesh = new Mesh(gl, { geometry, program });

    const updateSize = () => {
      renderer.dpr = Math.min(window.devicePixelRatio, 2);
      const { clientWidth: w, clientHeight: h } = holder;
      renderer.setSize(w, h);
      uniforms.iResolution.value = [w * renderer.dpr, h * renderer.dpr];
    };
    const onResize = () => updateSize();
    window.addEventListener('resize', onResize);
    updateSize();

    let raf = 0;
    const loop = (t: number) => {
      // VT 换页后旧画布已脱离文档 → 停止渲染（不随新页重建）
      if (!gl.canvas.isConnected) return;
      uniforms.iTime.value = t * 0.001;
      renderer.render({ scene: mesh });
      raf = requestAnimationFrame(loop);
    };
    raf = requestAnimationFrame(loop);
  };
  document
    .querySelectorAll<HTMLElement>('[data-rays]')
    .forEach((h) => bindRays(h, h.nextElementSibling));
</script>

<style>
  /* 容器即画布视口：overlay 叠在所在容器之上（滤色叠光），backdrop 沉在正文后 */
  .rays {
    position: fixed;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    mix-blend-mode: screen;
    z-index: -1; /* backdrop 默认：玻璃卡后方 */
    opacity: 1;
  }
  .rays canvas {
    width: 100% !important;
    height: 100% !important;
    display: block;
  }
  /* overlay（胶片画廊 arena 内）：absolute 填满相对定位的舞台容器，盖在胶片上。
     ⚠ 勿改 fixed 全视口：破坏 mix-blend 合成（§70 回退教训）。 */
  .rays--overlay {
    position: absolute;
    inset: 0;
    z-index: 20;
  }
  /* navstrip（§72）：顶栏透光 = 全视口同款入射光裁出顶栏条带 —— canvas 按
     全视口绘制（与 arena 光位/形态同源），clip-path 只留顶栏 56px（z59 < 顶栏
     z60，经毛玻璃 blur 透出 = 真·光穿玻璃）；blend/层级不与 arena overlay 冲突 */
  .rays--navstrip {
    position: fixed;
    inset: 0;
    z-index: 59;
    clip-path: inset(0 0 calc(100% - var(--nav-h)) 0);
  }
</style>
