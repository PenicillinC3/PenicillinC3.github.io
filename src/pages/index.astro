---
import Base from '../layouts/Base.astro';
import FluidGlass from '../components/FluidGlass.jsx';
import { site } from '../site.config';
---
<!-- 欢迎页。站名 = 打字机动效（spec §39/§40：逐字打出一次后定格，光标继续闪烁）。
     §69：全屏垫底 react-bits FluidGlass 玻璃球 island（方案 B，白网格折射内容）；
     其余页面仍零框架 -->
<Base>
  <div class="glass-scene" aria-hidden="true">
    <FluidGlass client:load />
  </div>
  <section class="welcome">
    <div class="stack">
      <h1 class="name" data-type-name={site.title} aria-label={site.title}>
        <span class="tp" data-type-text aria-hidden="true">{site.title}</span><span class="caret" data-caret aria-hidden="true">_</span>
      </h1>
      <p class="tagline">{site.tagline}</p>
      <div class="acts">
        <a class="btn prism" href="/notes/">个人笔记</a>
        <a class="btn prism" href="/photos/">摄影作品集</a>
      </div>
    </div>
  </section>
</Base>

<!-- 解析期先清空站名文本：避免先闪现完整站名再从头重打；
     顺带挂 html.js 供 CSS 只在有 JS 时开光标闪烁（无 JS 落回静态全文 + 无光标） -->
<script is:inline>
  document.documentElement.classList.add('js');
  if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const n = document.querySelector('[data-type-name]');
    const t = n && n.querySelector('[data-type-text]');
    if (t) t.textContent = '';
  }
</script>

<script>
  // —— 站名打字机（spec §39/§40）：逐字打出一次后定格全文（不打字时的
  //    删除/循环已按用户要求移除），光标持续闪烁 ——
  const cfg = { type: 75 };
  const wait = (ms: number) => new Promise<void>((r) => setTimeout(r, ms));
  const h1 = document.querySelector<HTMLElement>('[data-type-name]');
  if (h1 && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const txt = h1.querySelector<HTMLElement>('[data-type-text]')!;
    const full = h1.dataset.typeName ?? 'PenicillinC3';

    // 预留「完整站名 + 光标」的整宽：打字/删除过程中 h1 宽度恒定，
    // 居中文本从中心向两侧生长，不逐字左右跳
    const measure = () => {
      const probe = document.createElement('span');
      probe.style.cssText =
        'position:absolute;visibility:hidden;white-space:nowrap;pointer-events:none;top:0;left:0';
      probe.textContent = full + '_';
      h1.appendChild(probe);
      h1.style.width = `${probe.offsetWidth}px`;
      probe.remove();
    };
    let rsT: number | undefined;
    const W = window as unknown as { __typerResize?: boolean };
    if (!W.__typerResize) {
      W.__typerResize = true; // 换页重挂只补一次 resize 监听
      window.addEventListener('resize', () => {
        window.clearTimeout(rsT);
        rsT = window.setTimeout(measure, 150); // 字号随 vw 变 → 重测整宽
      });
    }

    const run = async () => {
      measure();
      txt.textContent = '';
      for (let i = 1; i <= full.length; i++) {
        if (!h1.isConnected) return; // 换页离场即停
        txt.textContent = full.slice(0, i);
        await wait(cfg.type);
      }
      // 定格：全文常驻，仅光标继续闪烁
    };
    (document.fonts?.ready ?? Promise.resolve()).then(run).catch(run);
  }
</script>

<style>
  /* —— §69 玻璃球层叠：canvas fixed 全屏垫底(z0)，顶栏(z60)/欢迎内容(z1)/页脚(z1)
       提层盖其上；顶栏、欢迎文字都允许事件穿透到 canvas（球全域跟手），
       唯按钮区保留交互（pointer-events auto） —— */
  .glass-scene {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none; /* 包装层穿透；canvas 子元素自身重新接收事件 */
  }
  .glass-scene canvas,
  .glass-scene > div {
    pointer-events: auto; /* R3F 事件绑在 canvas 或其容器 div 上，两者都放行 */
    display: block;
  }
  :global(.main:has(.welcome)) {
    position: relative;
    z-index: 1; /* 盖过 canvas 层（fixed 定位元素默认画在普通流之上） */
  }
  :global(.welcome) {
    pointer-events: none; /* 文字区不拦 pointer → canvas 收到事件、球全域跟手 */
  }
  :global(.welcome .acts) {
    pointer-events: auto; /* 两枚入口按钮保留点击/悬停 */
  }
  :global(body:has(.welcome) > footer) {
    position: relative;
    z-index: 1; /* 首页版权行：垫底 canvas 之上可见 */
  }

  .welcome {
    flex: 1 1 auto;
    min-height: 0;
    display: grid;
    place-items: center;
    text-align: center;
    padding-block: clamp(24px, 6vh, 72px);
  }
  .stack {
    display: grid;
    justify-items: center;
  }
  .name {
    margin: 0;
    font-family: var(--font-song);
    font-size: clamp(3rem, 9.5vw, 5.6rem);
    font-weight: 600;
    line-height: 1.15;
    letter-spacing: 0.04em; /* 拉丁长站名，收紧字距比华文中宋习惯值更稳 */
    color: var(--text-1);
  }
  .tagline {
    margin: clamp(14px, 3vh, 26px) 0 0;
    font-size: clamp(1.05rem, 2.6vw, 1.35rem);
    font-weight: 400;
    color: var(--text-2);
    letter-spacing: 0.02em;
  }
  .acts {
    margin-top: clamp(28px, 5vh, 46px);
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
  }

  /* —— 打字机光标（spec §39）：下划线逐格闪烁（周期 1s，两态对半）；仅 html.js 亮起 —— */
  .caret {
    display: inline-block;
    animation: caret-blink 1s steps(1, end) infinite;
  }
  html:not(.js) .caret { display: none; } /* 无 JS：静态全文 + 不闪光标 */
  @media (prefers-reduced-motion: reduce) {
    .caret { display: none; } /* 减动效用户：全文常驻（JS 侧同样跳过打字） */
  }
  @keyframes caret-blink {
    50% { opacity: 0; }
  }
</style>
