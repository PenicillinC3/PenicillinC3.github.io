---
import Base from '../layouts/Base.astro';
import HomeTitle from '../components/HomeTitle.jsx';
import { site } from '../site.config';
---
<Base>
  <section class="welcome">
    <div class="stack">
      <!-- §107：DOM h1 保语义/无 JS 回退；TechText 首帧画完后 html.tt-on
           让 h1 淡出、画布淡入（见 HomeTitle.jsx） -->
      <div class="title-stage">
        <h1 class="name">{site.title}</h1>
        <HomeTitle client:load />
      </div>
      <p class="tagline">{site.tagline}</p>
      <div class="acts">
        <!-- §100：两枚主入口在加载时即预取目标页，点击后立刻换页（不再有等待） -->
        <a class="btn prism" href="/notes/" data-astro-prefetch="load">个人笔记</a>
        <a class="btn prism" href="/photos/" data-astro-prefetch="load">摄影作品集</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .welcome {
    position: relative;
    z-index: 1;
    pointer-events: none; /* 空白区穿透；标题层与按钮各自重开 */
  }
  .acts {
    pointer-events: auto;
  }
  :global(body:has(.welcome) > footer) {
    position: relative;
    z-index: 1;
  }

  /* —— 站名舞台（React island 渲染，需全局选择器）——
     §109：高度 = 原 h1 行盒（clamp × 1.15）**再上下各留 36px**。
     TechText 的 pad 与这里必须成对：画布多出来的 36px 让选中框角标和 specks
     有地方飞，否则撒到画布外会被裁掉（看着像撞空气墙）。里面那圈布局盒仍是
     原来的 121px，所以字形大小没变。改这里记得同步 pad。 —— */
  :global(.title-stage) {
    position: relative;
    /* §109：100% + max-width，而不是 min(92vw, …) —— 92vw 按**视口**算，不含
       scrollbar-gutter 预留的 15px，窄屏上会比 .main 的内容盒宽出约 20px，
       把整页顶出横向滚动条。这里跟随父级可用宽度，两侧留白交给 .wrap 的 gutter。 */
    width: 100%;
    max-width: 1120px;
    height: calc(clamp(1.9rem, 11vw, 6.6rem) * 1.15 + 72px);
    /* §110：站名专用墨色（比正文 --text-1 #17191f 更深更暖）。必须写在 .title-stage
       上而不是 .name：TechText 的线框/specks 取的是容器的 currentColor，
       只改 h1 会出现「字变了、框没变」。 */
    color: var(--title-ink);
    pointer-events: auto; /* 悬停揭示 / 拖拽字母 */
  }
  :global(.title-stage .name) {
    position: absolute;
    inset: 0;
    margin: 0;
    display: grid;
    place-items: center;
    font-family: var(--font-title);
    /* §91：窄屏由 11vw 主导，避免 clamp 下限把长站名撑出视口 */
    font-size: clamp(1.9rem, 11vw, 6.6rem);
    font-weight: 400;
    line-height: 1.15;
    letter-spacing: 0.02em;
    color: inherit; /* §110：跟随 .title-stage 的站名墨色（无 JS 回退时与画布同色） */
    transition: opacity 0.25s ease-out;
  }
  :global(.tech-layer) {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 0.3s ease-out;
  }
  /* TechText 首帧画完后才加 tt-on（无 JS / island 失败 → h1 保持可见） */
  :global(html.tt-on .name) {
    opacity: 0;
    user-select: none;
  }
  :global(html.tt-on .tech-layer) {
    opacity: 1;
  }

  .welcome {
    flex: 1 1 auto;
    min-height: 0;
    display: grid;
    place-items: center;
    text-align: center;
    padding-block: clamp(24px, 6vh, 72px);
  }
  .stack {
    display: grid;
    /* §109：显式单列（撑满可用宽），否则 auto 轨道按内容定宽 —— width:100%
       的 .title-stage 会退化到跟 .acts 一样宽（实测 279px） */
    grid-template-columns: minmax(0, 1fr);
    justify-items: center;
    width: 100%;
  }
  .tagline {
    margin: clamp(14px, 3vh, 26px) 0 0;
    font-size: clamp(1.05rem, 2.6vw, 1.35rem);
    font-weight: 400;
    color: var(--text-2);
    letter-spacing: 0.02em;
  }
  .acts {
    margin-top: clamp(28px, 5vh, 46px);
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
  }
</style>
