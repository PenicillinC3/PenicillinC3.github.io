---
import Base from '../layouts/Base.astro';
import FluidGlass from '../components/FluidGlass.jsx';
import HomeTitle from '../components/HomeTitle.jsx';
import { site } from '../site.config';
---
<!-- 欢迎页（spec §107）：站名主视觉 = TechText（Canvas 2D 技术图风格）。
     FluidGlass 已改成「加载页专用舞台」：首页不再显示玻璃球，它只负责首访
     加载页退场时那颗球与底板；仍挂 client:idle 让它在过渡前就绪。
     其余页面仍零框架。 -->
<Base>
  <div class="glass-scene" aria-hidden="true">
    <!-- §78：idle 水合 —— chunk 与首屏抢主线程；空闲时再拉取。加载页会等
         `__ballReady`（最多 BALL_WAIT_MS），等不到就走无球兜底。 -->
    <FluidGlass client:idle />
  </div>
  <section class="welcome">
    <div class="stack">
      <!-- §107：DOM h1 保语义/无 JS 回退；TechText 首帧画完后 html.tt-on
           让 h1 淡出、画布淡入（见 HomeTitle.jsx） -->
      <HomeTitle client:load />
      <p class="tagline">{site.tagline}</p>
      <div class="acts">
        <!-- §100：两枚主入口在加载时即预取目标页，点击后立刻换页（不再有等待） -->
        <a class="btn prism" href="/notes/" data-astro-prefetch="load">个人笔记</a>
        <a class="btn prism" href="/photos/" data-astro-prefetch="load">摄影作品集</a>
      </div>
    </div>
  </section>
</Base>

<style>
  /* —— 层叠（§69.1 教训保留）：canvas(fixed z0) 与 .welcome(z1) 须同处根级
       堆叠上下文。勿给 .main 加 z-index/transform —— 那会把 fixed canvas 收进
       main 自身堆叠上下文，内容反而压在 canvas 之下。
       §107 起 canvas 只服务加载过渡，首页没有可交互的球 → 整层 pointer-events:none。 —— */
  .glass-scene {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }
  .glass-scene canvas,
  .glass-scene > div { display: block; }
  .welcome {
    position: relative;
    z-index: 1; /* 盖过垫底 canvas */
    pointer-events: none; /* 空白区穿透；标题层与按钮各自重开 */
    transition: opacity 0.25s ease-out; /* pl-live 交班隐藏 */
  }
  .acts {
    pointer-events: auto;
  }
  :global(body:has(.welcome) > footer) {
    position: relative;
    z-index: 1; /* 首页版权行：垫底 canvas 之上可见 */
  }

  /* —— 站名舞台（React island 渲染，需全局选择器）——
     高度 = 原 h1 行盒（clamp × 1.15）；TechText 按 0.66×容器高自适应，
     落点与旧视觉字号基本一致。宽度给足，窄屏由 92vw 收缩。 —— */
  :global(.title-stage) {
    position: relative;
    width: min(92vw, 1120px);
    height: calc(clamp(1.9rem, 11vw, 6.6rem) * 1.15);
    pointer-events: auto; /* 悬停揭示 / 拖拽字母 */
  }
  :global(.title-stage .name) {
    position: absolute;
    inset: 0;
    margin: 0;
    display: grid;
    place-items: center;
    font-family: var(--font-song);
    /* §91：窄屏由 11vw 主导，避免 clamp 下限把长站名撑出视口 */
    font-size: clamp(1.9rem, 11vw, 6.6rem);
    font-weight: 500;
    line-height: 1.15;
    letter-spacing: 0.04em;
    color: var(--text-1);
    transition: opacity 0.25s ease-out;
  }
  :global(.tech-layer) {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 0.3s ease-out;
  }
  /* TechText 首帧画完后才加 tt-on（无 JS / island 失败 → h1 保持可见） */
  :global(html.tt-on .name) {
    opacity: 0;
    user-select: none;
  }
  :global(html.tt-on .tech-layer) {
    opacity: 1;
  }

  /* —— 加载页交班（§107）——
     transition() 删掉 DOM 加载层、由 WebGL 底板接管的那 1.6s 里，首页 DOM
     （标题 / tagline / 按钮 / 顶栏 / 页脚）必须让位，否则会浮在底板之上。
     settle() 摘掉 pl-live 后淡入；另有 10s 安全计时器兜底。 —— */
  :global(html.pl-live .welcome),
  :global(html.pl-live .topbar),
  :global(html.pl-live body > footer) {
    opacity: 0;
  }
  :global(.topbar),
  :global(body > footer) {
    transition: opacity 0.25s ease-out;
  }

  .welcome {
    flex: 1 1 auto;
    min-height: 0;
    display: grid;
    place-items: center;
    text-align: center;
    padding-block: clamp(24px, 6vh, 72px);
  }
  .stack {
    display: grid;
    justify-items: center;
  }
  .tagline {
    margin: clamp(14px, 3vh, 26px) 0 0;
    font-size: clamp(1.05rem, 2.6vw, 1.35rem);
    font-weight: 400;
    color: var(--text-2);
    letter-spacing: 0.02em;
  }
  .acts {
    margin-top: clamp(28px, 5vh, 46px);
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
  }
</style>
