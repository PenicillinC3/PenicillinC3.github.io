---
import Base from '../layouts/Base.astro';
import LensGlass from '../components/LensGlass';
import { site } from '../site.config';
---
<Base>
  <section class="welcome">
    <div class="stack">
      <h1 class="name">{site.title}</h1>
      <p class="tagline">{site.tagline}</p>
      <div class="acts">
        <a class="btn prism" href="/notes/">个人笔记</a>
        <a class="btn prism" href="/photos/">摄影作品集</a>
      </div>
      <!-- 液态玻璃镜头（spec §34）：React+Three 全真折射，位于站名右上，
           小范围阻尼跟随鼠标；折射画布内自绘背景（非页面 DOM） -->
      <div class="lens-slot" aria-hidden="true">
        <LensGlass client:visible follow={1.1} ior={1.15} thickness={3.5} chromaticAberration={0.1} anisotropy={0.02} />
      </div>
    </div>
  </section>
</Base>

<style>
  .welcome {
    flex: 1 1 auto;
    min-height: 0;
    display: grid;
    place-items: center;
    text-align: center;
    padding-block: clamp(24px, 6vh, 72px);
  }
  .stack {
    position: relative; /* lens-slot 定位上下文 */
    display: grid;
    justify-items: center;
  }
  .name {
    margin: 0;
    font-family: var(--font-song);
    font-size: clamp(3rem, 9.5vw, 5.6rem);
    font-weight: 600;
    line-height: 1.15;
    letter-spacing: 0.04em; /* 拉丁长站名，收紧字距比华文中宋习惯值更稳 */
    color: var(--text-1);
  }
  .tagline {
    margin: clamp(14px, 3vh, 26px) 0 0;
    font-size: clamp(1.05rem, 2.6vw, 1.35rem);
    font-weight: 400;
    color: var(--text-2);
    letter-spacing: 0.02em;
  }
  .acts {
    margin-top: clamp(28px, 5vh, 46px);
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
  }

  /* —— 液态玻璃镜头槽（spec §34）：覆盖站名右上区域 —— */
  .lens-slot {
    position: absolute;
    top: -11vh;
    right: -6vw;
    width: min(46vh, 60vw, 560px);
    height: min(34vh, 46vw, 420px);
    pointer-events: none; /* 镜头不拦交互（内部跟随走窗口事件） */
    z-index: 6;
  }
  @media (max-width: 900px) {
    .lens-slot { display: none; } /* 窄屏省算力，镜头仅桌面 */
  }
</style>
