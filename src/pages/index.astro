---
import Base from '../layouts/Base.astro';
import { site } from '../site.config';
---
<!-- spec §35：液态玻璃镜头已删除（React 栈随之下线），欢迎页回归纯站名 + tagline + 入口 -->
<Base>
  <section class="welcome">
    <div class="stack">
      <h1 class="name">{site.title}</h1>
      <p class="tagline">{site.tagline}</p>
      <div class="acts">
        <a class="btn prism" href="/notes/">个人笔记</a>
        <a class="btn prism" href="/photos/">摄影作品集</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .welcome {
    flex: 1 1 auto;
    min-height: 0;
    display: grid;
    place-items: center;
    text-align: center;
    padding-block: clamp(24px, 6vh, 72px);
  }
  .stack {
    display: grid;
    justify-items: center;
  }
  .name {
    margin: 0;
    font-family: var(--font-song);
    font-size: clamp(3rem, 9.5vw, 5.6rem);
    font-weight: 600;
    line-height: 1.15;
    letter-spacing: 0.04em; /* 拉丁长站名，收紧字距比华文中宋习惯值更稳 */
    color: var(--text-1);
  }
  .tagline {
    margin: clamp(14px, 3vh, 26px) 0 0;
    font-size: clamp(1.05rem, 2.6vw, 1.35rem);
    font-weight: 400;
    color: var(--text-2);
    letter-spacing: 0.02em;
  }
  .acts {
    margin-top: clamp(28px, 5vh, 46px);
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
  }
</style>
