    // ── 开场解密揭示（与 Preloader.astro 同一套）────────────────────────
    // 除百分比外的文字逐字从乱码锁定成真字，单次；交班前收尾，3D 场景里是定格文字。
    // ⚠ 乱码字符集必须落在 MaplePre 子集内，否则动画途中逐字回退到别的字体。
    var ORACLE = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789/.:%()-+';
    var DECRYPT_MS = 2000, DECRYPT_STAGGER = 160;   // 基准值，与 Preloader.astro 同源
    var FLICKER_MS = 100;                           // 单个乱码字多久翻一次
    var decScale = 2.8;                             // 滑块倍率（2.8 = 线上当前值）
    var dec = [], decOn = false;
