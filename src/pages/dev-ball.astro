    // 约 2710px 是「相机进入球内、球消失」的分界，见 BALL_RADIUS_PX 的注释。
    var brd = document.getElementById('brd'), brdv = document.getElementById('brdv');
    function radiusFromSlider(v) { return 10 * Math.pow(2000, v / 100); }
    brd.addEventListener('input', function () {
