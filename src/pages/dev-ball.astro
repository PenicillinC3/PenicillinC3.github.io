    // 拖完立刻重揭一次，好马上看到快慢（不用等重播）。定下来后改 Preloader 里那两个常数。
    var dcr = document.getElementById('dcr'), dcrv = document.getElementById('dcrv');
    dcr.addEventListener('input', function () {
