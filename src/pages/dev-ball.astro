      // 不拦住的话乱码还没定形就被计数盖掉）
      if (!decOn) {
        vels[0].textContent = pad(Math.floor(13 * p), 2) + ' / 13';
        vels[1].textContent = pad(Math.floor(34 * p), 2) + ' / 34';
        vels[2].textContent = (1.9 * p).toFixed(1) + ' MB';
        vels[3].textContent = pad(Math.floor(8 * p), 1) + ' / 8';
      }
    }

    function reset() {
      swapped = false;
      el.classList.remove('gone');
      window.__plPlate = null;
      window.__lensScene = 0;
      window.__lensScale = 0;
      window.__lensTransition = false;
      window.__lensBall = false;
      delete window.__homeGrow;
      delete window.__lensZ;     // 交还给 FluidGlass 的默认 15
      window.__lensOptics = opticsBase;   // 褪光学那段的改动要还原
      startDecrypt();            // 重播时重新揭一次（预览页专有；真组件只播一次）
    }

    function frame(now) {
      var dt = (now - last) / 1000; last = now;
      if (playing) { clock += dt * speed; if (clock >= TOTAL) { clock -= TOTAL; reset(); } }

      tickDecrypt(now);
      var t = clock;
      if (t < T_LOAD) {
        paint(ease(t / T_LOAD));
        stgEl.textContent = '加载';
        if (swapped) reset();
      } else if (t < T_LOAD + T_HOLD) {
        paint(1);
        stgEl.textContent = '100%';
      } else {
        // 交班：加载页版面烘进 3D 场景 → 撤下 DOM 层 → 中央呼出球
        if (!swapped) {
          swapped = true;
          finishDecrypt();                  // 烘底板前先定格，别把乱码烘进去
          // ⚠ 紧接着补一次 paint：解密期间数值列是被让出去的（decOn 早退），
          //   不补就会把标记里的初始值烘进底板。真组件里是 paintCounts()，同一个道理。
          paint(1);
          window.__plPlate = makePlate();   // 球从此折的是加载页
          window.__lensScene = 0;           // 底板不透明 = 场景里就是加载页
          window.__lensScale = 0;
          el.classList.add('gone');
        }
        // 用户要求：加载完成后**不呼出球** —— 只把底板挖洞，洞后露出首页。
        // 要恢复呼出：把 SUMMON_BALL 改回 true（球半径 / 贴脸距 / 光学三个滑块都还在）。
        var t2 = t - T_LOAD - T_HOLD;            // 交班之后的相对时间
        var u = ease(Math.min(1, t2 / T_CALL));
        window.__lensScale = SUMMON_BALL ? summonScale() * u : 0;
        // 球心随尺寸同步后退，球面始终停在相机前固定距离 —— 否则球一大就把相机吞进去
        window.__lensZ = CAM_Z - BALL_GAP_W - summonScale() * (SUMMON_BALL ? u : 0) * MODEL_R_W;
        // 本页是**加载页的预览**：上场的自始至终是**加载页那颗球**（独立 mesh）。
        window.__lensBall = true;
        window.__lensTransition = true;

        // ② 褪光学：从滑块那个强度衰减到 0（中性玻璃 = ior 1 / 厚度 0 / 无色差）
        var opt = 1;
        if (t2 > T_CALL) {
          var of = Math.min(1, (t2 - T_CALL) / T_FADE);
          opt = 1 - ease(of);
        }
        window.__lensOptics = opticsBase * opt;

        // ③ 撤场：底板淡出（__lensScene 0→1 驱动它的 opacity）、球同步缩没
        if (t2 > T_CALL + T_FADE) {
          // 球：褪完光学**立即整颗删掉**，没有收回动画（用户明确要求）。
          // 底板继续淡出（不能硬删，否则会「啪」地跳一下）。
          window.__lensBall = false;
          // ⚠ 与上一行同时置零：首页那颗的可见性只看 __lensBall，晚一步就会闪一下
          //   （它已经可见、而 __homeGrow 还是 undefined = 满尺寸）。
          window.__homeGrow = 0;
          var oo = ease(Math.min(1, (t2 - T_CALL - T_FADE) / T_OUT));
          window.__lensScene = oo;
          // 首页那颗**从首页自己长出来**（与真组件同一套）：只推 __homeGrow 0→1，
          // 不碰加载页那几个量。不推的话它会「啪」地跳成常态尺寸。
          window.__homeGrow = ease(Math.min(1, (t2 - T_CALL - T_FADE) / 0.8));
        }

        stgEl.textContent = !SUMMON_BALL ? '挖洞'
          : t2 < T_CALL ? '呼出球'
          : t2 < T_CALL + T_FADE ? '褪光学'
          : t2 < T_CALL + T_FADE + T_OUT ? '撤场' : '落定';
      }
      // 球半径（像素）：呼出球时按实时 scale 算，不呼出时用滑块那个**标称值** ——
      // 否则 SUMMON_BALL=false 会让 live scale 恒为 0，洞径跟着算成 0（洞就不见了）。
      var ballPx = SUMMON_BALL && typeof window.__lensScale === 'number'
        ? window.__lensScale / worldPerPx() : BALL_RADIUS_PX;
      radEl.textContent = ballPx.toFixed(0);
      // 洞径随球半径每帧同步（球在生长时洞得跟着长）
      window.__lensHolePx = holeRatio > 0.005 ? ballPx * holeRatio : 0;
      scrubv.textContent = Math.round((t / TOTAL) * 100) + '%';
      if (playing) scrub.value = String(Math.round((t / TOTAL) * 1000));
      requestAnimationFrame(frame);
    }
    reset();
    paint(0);
    requestAnimationFrame(frame);
  </script>
</body>
</html>
