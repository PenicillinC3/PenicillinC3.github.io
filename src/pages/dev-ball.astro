      var pg = Rc(q('.pl-prog b')) || Rc(q('.pl-prog'));
      if (pg) {
        var g = o.createLinearGradient(pg.left, 0, pg.right, 0);
        g.addColorStop(0, '#ff2d9b'); g.addColorStop(.22, '#a24bff'); g.addColorStop(.44, '#00d4ff');
