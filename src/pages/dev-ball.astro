      cs = cs || getComputedStyle(e);
      _mc.font = cs.fontStyle + ' ' + cs.fontWeight + ' ' + cs.fontSize + ' ' + cs.fontFamily;
      var m = _mc.measureText('M');
      var a = m.fontBoundingBoxAscent, d = m.fontBoundingBoxDescent, lh = parseFloat(cs.lineHeight);
