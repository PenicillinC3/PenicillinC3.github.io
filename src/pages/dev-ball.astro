    // （.pl-hero 里叠着一根 16px 固定结构行），所以只能量。
    function alignData() {
      var rows = el.querySelectorAll('.pl-data s'), num = el.querySelector('.pl-num');
      if (!rows.length || !num) return;
      // ⚠ 先归零再量：会被 resize / fonts.ready 反复调用，不归零就会滚雪球（见 Preloader 同名段）
      el.style.setProperty('--data-lift', '0px');
