    // 球的大小每帧在变，所以洞径不在这里算，交给 frame() 每帧写（见下）。
    var hol = document.getElementById('hol'), holv = document.getElementById('holv');
    var holeRatio = 14;
    hol.addEventListener('input', function () {
      holeRatio = parseFloat(hol.value);
      holv.textContent = holeRatio.toFixed(2) + '×';
    });

    // 竖栏收起：它贴在左边，会盖住加载页的眉标与大数字，调参时能收起来。
    var fold = document.getElementById('fold');
    fold.addEventListener('click', function () {
      var u = document.querySelector('.ui');
      u.classList.toggle('folded');
      fold.textContent = u.classList.contains('folded') ? '展开' : '收起';
    });

    // 贴脸距：球面停在相机前方多少个世界单位。**球越大这个值越关键** ——
    // 贴太近（~1）会变成强放大镜 + 重色差，整版被放大到看不出原样；拉开则退成一层薄玻璃。
    // 只有世界半径 > 5（相机到球心的距离）时它才真正起作用，小球时无感。
    var gap = document.getElementById('gap'), gapv = document.getElementById('gapv');
    gap.addEventListener('input', function () {
      BALL_GAP_W = parseFloat(gap.value);
      gapv.textContent = BALL_GAP_W.toFixed(1);
    });
    function setPlaying(v) { playing = v; btn.textContent = playing ? '暂停' : '播放'; }
    btn.addEventListener('click', function () { setPlaying(!playing); });
    // 空格键 = 播放/暂停。⚠ preventDefault 不能省：焦点停在按钮上时空格会**再按一次那个按钮**
    // （等于连翻两次，看起来像没反应），停在滑块上则会把它推到端点。
    // 另外忽略 e.repeat —— 按住不放会以按键重复频率疯狂翻转。
    window.addEventListener('keydown', function (e) {
