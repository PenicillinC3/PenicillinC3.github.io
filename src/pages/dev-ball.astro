---
// §102 迭代预览：**加载页 → 3D 场景 → 中央呼出玻璃球**。
//
// 与首页无关。球折射的是**加载页自己**：
//   加载完成后把加载页版面烘成一张 canvas（window.__plPlate），塞进 FluidGlass 的场景
//   （LoadingPlate 那块 z=5 的平面），再把 DOM 加载层撤下 —— 屏幕上还是同一张版面，
//   但它此刻是 WebGL 画出来的，于是**球的折射够得着它**。
//   （DOM 在 WebGL 之上，球的 shader 只采样自己的离屏 buffer，碰不到 DOM ——
//    这就是为什么非得「把加载页变成 3D 场景」不可。）
//
// 球的光学走 FluidGlass 原生路径：scale = LENS_PROPS.scale (0.10)、材质参数原样。
// 访问 /dev-ball
import FluidGlass from '../components/FluidGlass.jsx';
import { readFileSync } from 'node:fs';
import { resolve } from 'node:path';

// 与 Preloader.astro 同一套内联子集 —— 预览页的字体必须和真组件一致，
// 否则在这里调好的排版/字距换到线上就变样。两张都 base64 进内联 <style>，首帧即到位。
const fontB64 =
  'data:font/woff2;base64,' +
  readFileSync(resolve(process.cwd(), 'public/fonts/helv-swiss.woff2')).toString('base64');
const mapleB64 =
  'data:font/woff2;base64,' +
  readFileSync(resolve(process.cwd(), 'public/fonts/maple-pre.woff2')).toString('base64');

// ⚠ @font-face 必须走 set:html 注入。`<style is:inline>` 的元素内容**不插值 `${}`**
//   （跟 CLAUDE.md 坑 2 的 `<script is:inline>` 是同一条），写成 ${fontB64} 会原样输出
//   字面量 → CSS 解析失败 → 两种字体都静默回退（实测落到 NSimSun / Arial）。
const fontCss = `
  @font-face{ font-family:'HelvSwiss'; src:url("${fontB64}") format('woff2');
    font-weight:100 900; font-display:block; }
  @font-face{ font-family:'MaplePre'; src:url("${mapleB64}") format('woff2');
    font-weight:700; font-display:block; }
`;
---

<!DOCTYPE html>
<html lang="zh">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <!-- 临时预览页：不收录、不跟随外链。没有链接指向它，但它是站上的公开路由，
       上线期间不希望被搜索引擎抓到。验收完整个文件会被删掉。 -->
  <meta name="robots" content="noindex, nofollow" />
  <title>加载页 → 3D 场景 → 球</title>
  <style is:inline set:html={fontCss}></style>
  <style is:inline>
    *, *::before, *::after { box-sizing: border-box; }
    html, body { height: 100%; }
    body { margin: 0; background: #f7f7f6; }
    /* 组件不自带定位：漏了这条 canvas 会掉进页面流、跑到视口外，球静默消失 */
    .glass-scene { position: fixed; inset: 0; z-index: 0; pointer-events: none; }
    /* 首页占位：只提供测量，自身不可见 */
    .home-ghost { position: fixed; inset: 0; z-index: 0; pointer-events: none;
      display: grid; place-items: center; text-align: center; }
    .home-ghost h1 { margin: 0; opacity: 0; font-weight: 500; line-height: 1.15;
      font-family: 'Song Web', '华文中宋', STZhongsong, serif;
      font-size: clamp(1.9rem, 11vw, 6.6rem); letter-spacing: .04em; color: #17191f; }
    .home-ghost p { margin: clamp(14px, 3vh, 26px) 0 0; opacity: 0;
      font-size: clamp(1.05rem, 2.6vw, 1.35rem); letter-spacing: .02em; color: #565d6e; }
    .glass-scene canvas, .glass-scene > div { pointer-events: auto; display: block; }

    /* ⚠ 可换行 + 上限宽度：滑块一路加到六个之后，这条已经 1969px —— 1280 下溢出 689px。
       别去掉 flex-wrap，否则再加一个控件又会横着长出去。 */
    /* 左侧竖栏。原来那条底部横条随着控件增加一路涨到 1969px（1280 下溢出 689px），
       而且横着排的标签和滑块对不上号；竖排之后每项自成一行：上排「名称 + 数值」、下排滑块。 */
    .ui { position: fixed; left: 16px; top: 50%; transform: translateY(-50%); z-index: 10001;
      display: flex; flex-direction: column; gap: 9px; width: 178px; padding: 12px 13px;
      max-height: calc(100vh - 40px); overflow-y: auto;
      background: rgba(18,18,22,.92); color: #e8e8ea; border-radius: 11px;
      font: 11px/1.35 system-ui, sans-serif; }
    .ui.folded .ctl, .ui.folded .rd { display: none; }
    .ui .ctl { display: flex; flex-direction: column; gap: 4px; }
    .ui .h { display: flex; justify-content: space-between; align-items: baseline; gap: 8px; }
    .ui .h span { color: #8b8b95; text-transform: uppercase; letter-spacing: .12em; font-size: 9px; }
    .ui b { font-variant-numeric: tabular-nums; font-size: 11px; }
    .ui input[type=range] { -webkit-appearance: none; appearance: none;
      width: 100%; height: 3px; background: #3a3a44; border-radius: 2px; outline: none; }
    .ui input[type=range]::-webkit-slider-thumb { -webkit-appearance: none; width: 13px; height: 13px;
      border-radius: 50%; background: #7dff3d; cursor: grab; }
    .ui button { background: #2a2a32; color: #e8e8ea; border: 0; border-radius: 7px;
      padding: 7px 12px; font: inherit; cursor: pointer; }
    .ui .mini { padding: 4px 8px; font-size: 10px; color: #8b8b95; align-self: flex-start; }
    .ui .rd { color: #7a7a84; font-variant-numeric: tabular-nums; font-size: 10px; line-height: 1.5; }
    .ui .rd em { color: #e8e8ea; font-style: normal; }
    .scrub { position: fixed; left: 0; right: 0; bottom: 0; z-index: 10002;
      display: flex; align-items: center; gap: 10px; padding: 8px 16px 10px;
      background: rgba(18,18,22,.92); color: #8b8b95;
      font: 10px/1 system-ui, sans-serif; letter-spacing: .14em; text-transform: uppercase; }
    .scrub input { flex: 1; -webkit-appearance: none; appearance: none; height: 4px;
      background: #3a3a44; border-radius: 2px; outline: none; }
    .scrub input::-webkit-slider-thumb { -webkit-appearance: none; width: 14px; height: 14px;
      border-radius: 50%; background: #fff; cursor: grab; }
    .scrub b { min-width: 46px; text-align: right; color: #e8e8ea;
      font-variant-numeric: tabular-nums; letter-spacing: .04em; }

    /* ---------- 加载页 ---------- */
    #pl { position: fixed; inset: 0; z-index: 9999; overflow: hidden;
      background: #f7f7f6; color: #1a1a1a;
      font-family: 'HelvSwiss', 'Helvetica Neue', Helvetica, Arial, sans-serif; --p: 0; }
    /* 标签/眉标/数据栏 Maple，百分比仍留 Helvetica（与 Preloader.astro 一致） */
    .pl-lbl, .pl-eyebrow, .pl-data {
      font-family: 'MaplePre', 'MapleUI Web', 'MapleMono Web', ui-monospace, monospace; }
    #pl.gone { display: none; }          /* 交班给 3D 场景后撤下 DOM 层 */
    .pl-scene { position: absolute; inset: 0; z-index: 1; }
    .pl-grid { position: absolute; left: 4.5%; right: 4.5%; top: 10%; bottom: 16%; z-index: 1; display: flex; pointer-events: none; }
    .pl-grid i { flex: 1; position: relative; }
    .pl-grid i::before { content: ''; position: absolute; left: 0; top: 0; width: 1px;
      background: rgba(26,26,26,.09); height: calc(var(--gh,0) * 100%); }
    .pl-grid i:last-child { flex: 0; }
    .pl-rule { position: absolute; height: 1px; background: rgba(26,26,26,.3); z-index: 2;
      transform-origin: left center; transform: scaleX(var(--rw,0)); }
    .pl-rule-t { left: 4.5%; width: calc(91% / 12 * 6); top: 10%; }
    .pl-rule-b { left: 4.5%; right: 4.5%; bottom: 16%; }
    .pl-res { position: absolute; inset: 0; z-index: 4; }
    .pl-lbl { position: absolute; font-weight: 700; font-size: clamp(10px,1.55vw,20px);
      letter-spacing: calc(var(--ls,.5) * .13em); text-transform: uppercase; font-variant-numeric: tabular-nums; }
    .pl-tl { top: 5%; left: 4.5%; } .pl-tr { top: 5%; right: 4.5%; display: flex; align-items: center; gap: .62em; }
    .pl-bl { bottom: 5.6%; left: 4.5%; color: #8a8a88; } .pl-br { bottom: 5.6%; right: 4.5%; color: #8a8a88; }
    .pl-dot { width: .56em; height: .56em; border-radius: 50%; background: #1a1a1a; display: inline-block; }
    .pl-stage { position: absolute; left: 4.5%; right: 4.5%; top: 10%; bottom: 16%;
      display: flex; align-items: flex-end; justify-content: space-between; }
    /* +24px = 14(巨数墨迹溢出补偿) + 10(用户要求眉标再上抬) —— 与 Preloader.astro 一致 */
    .pl-left { display: flex; flex-direction: column; gap: calc(.55vh + 24px); align-items: flex-start; }
    .pl-eyebrow { font-weight: 700; font-size: clamp(13px,2.6vh,26px); letter-spacing: calc(var(--ls,.5) * .3em); text-transform: uppercase; }
    .pl-hero { display: flex; align-items: baseline; line-height: .71; margin-left: -.035em; }
    .pl-num { font-weight: 700; letter-spacing: -.042em; font-size: 22vh; font-variant-numeric: tabular-nums; }
    .pl-pct { font-weight: 700; font-size: 6.6vh; color: #8a8a88; }
    /* margin-bottom 由脚本量的 --data-lift 给：把最后一行基线抬到大数字那条线上 */
    .pl-data { display: grid; grid-template-columns: auto auto; gap: .42em .7em;
      margin-bottom: var(--data-lift, 0px);
      font-weight: 700; font-size: clamp(11px,1.62vw,21px); letter-spacing: calc(var(--ls,.5) * .15em); text-transform: uppercase; }
    .pl-data span { grid-column: 1; color: #8a8a88; text-align: right; }
    .pl-data s { grid-column: 2; text-decoration: none; font-variant-numeric: tabular-nums; text-align: right; }
    .pl-prog { position: absolute; left: 4.5%; right: 4.5%; bottom: calc(16% - 1px); height: 2px;
      background: rgba(26,26,26,.12); z-index: 5; }
    .pl-prog b { display: block; height: 2px; width: 100%;
      background: linear-gradient(90deg,#ff2d9b,#a24bff 22%,#00d4ff 44%,#7dff3d 64%,#ffe600 82%,#ff6b1a);
      clip-path: inset(0 calc((1 - var(--p,0)) * 100%) 0 0); }
    .pl-mist { position: absolute; inset: 0; z-index: 6; pointer-events: none;
      background: linear-gradient(180deg, rgba(180,180,186,.30), rgba(156,156,164,.36));
      opacity: var(--mist,1);
      -webkit-backdrop-filter: blur(7px) saturate(.55); backdrop-filter: blur(7px) saturate(.55); }
  </style>
</head>
<body>
  <div class="ui">
    <button id="play">暂停</button>
    <div class="ctl"><div class="h"><span>光学</span><b id="optv">1.00</b></div><input id="opt" type="range" min="0.05" max="1.5" step="0.05" value="1" /></div>
    <div class="ctl"><div class="h"><span>洞径</span><b id="holv">14.00×</b></div><input id="hol" type="range" min="5" max="20" step="0.1" value="14" /></div>
    <div class="ctl"><div class="h"><span>速度</span><b id="spdv">1.00×</b></div><input id="spd" type="range" min="0.1" max="4" step="0.05" value="1" /></div>
    <div class="ctl"><div class="h"><span>模糊起</span><b id="blrv">7.3px</b></div><input id="blr" type="range" min="0.83" max="24" step="0.1" value="7.3" /></div>
    <div class="ctl"><div class="h"><span>曲线</span><b id="bpwv">2.0</b></div><input id="bpw" type="range" min="1" max="4" step="0.1" value="2" /></div>
    <div class="ctl"><div class="h"><span>字距</span><b id="lspv">0.50</b></div><input id="lsp" type="range" min="0" max="1.5" step="0.05" value="0.5" /></div>
    <div class="ctl"><div class="h"><span>解密</span><b id="dcrv">2.8×</b></div><input id="dcr" type="range" min="0.3" max="3" step="0.1" value="2.8" /></div>
    <div class="ctl"><div class="h"><span>闪动</span><b id="flkv">100ms</b></div><input id="flk" type="range" min="16" max="300" step="4" value="100" /></div>
    <div class="ctl"><div class="h"><span>球半径</span><b id="brdv">663px</b></div><input id="brd" type="range" min="0" max="100" step="1" value="55" /></div>
    <div class="ctl"><div class="h"><span>贴脸距</span><b id="gapv">0.2</b></div><input id="gap" type="range" min="0.2" max="12" step="0.1" value="0.2" /></div>
    <div class="ctl"><div class="h"><span>光学</span><b id="optv">1.00</b></div><input id="gap" type="range" min="0.2" max="12" step="0.1" value="0.2" /></div>
    <button id="fold" class="mini">收起</button>
    <div class="rd">阶段 <em id="stg">加载</em><br>球半径 <em id="rad">—</em> px<br>空格 播放/暂停</div>
  </div>
  </div>

  <div id="pl">
    <div class="pl-scene">
      <div class="pl-grid"></div>
      <div class="pl-rule pl-rule-t"></div>
      <div class="pl-rule pl-rule-b"></div>
      <div class="pl-res">
        <span class="pl-lbl pl-tl">Penicillinc3</span>
        <span class="pl-lbl pl-tr"><i class="pl-dot"></i>Syncing</span>
        <div class="pl-stage">
          <div class="pl-left">
            <span class="pl-eyebrow">///Loading</span>
            <div class="pl-hero"><span class="pl-num">000</span><span class="pl-pct">%</span></div>
          </div>
          <div class="pl-data">
            <span>Routes</span><s>00 / 13</s>
            <span>Assets</span><s>00 / 34</s>
            <span>Bytes</span><s>0.0 MB</s>
            <span>Fonts</span><s>0 / 8</s>
          </div>
        </div>
        <span class="pl-lbl pl-bl">Site Index</span>
        <span class="pl-lbl pl-br">Ingest 01</span>
      </div>
      <div class="pl-prog"><b></b></div>
      <div class="pl-mist"></div>
    </div>
  </div>

  <div class="scrub">
    <span>进度</span>
    <input id="scrub" type="range" min="0" max="1000" step="1" value="0" />
    <b id="scrubv">0%</b>
  </div>

  <!-- 洞后面的「首页」：FluidGlass 的 SceneTexts 按这两个选择器**实测 DOM** 换算成
       场景文字（troika + song-3d.ttf），所以这里必须有真实盒子在真实位置。
       opacity:0 与真首页同款 —— 视觉由 3D 场景承接，这里只提供测量与语义。
       规格抄自 src/pages/index.astro 的 .name / .tagline。 -->
  <div class="home-ghost" aria-hidden="true">
    <h1 data-scene-title>PenicillinC3</h1>
    <p data-scene-tagline>记录 · 拍摄 · 思考</p>
  </div>

  <div class="glass-scene" aria-hidden="true">
    <FluidGlass client:only="react" />
  </div>

  <script is:inline>
    var CAM_Z = 20, FOV = 15, BALL_Z = 15, BALL_SCALE = 0.10; // 与 FluidGlass 一致
    function worldPerPx() { return 2 * Math.tan((FOV * Math.PI) / 360) * (CAM_Z - BALL_Z) / innerHeight; }
    // 球的像素半径与 scale 是**线性**的：radiusPx = scale / worldPerPx()，所以反推 scale = px * worldPerPx()。
    // 20000px = 用户指定的「呼出后」半径（远超视口，球面在相机附近近乎平面）。
    // 换算下来 scale ≈ 36.6 —— 作为参照，铺满视口对角线只要 ≈ 3.46。
    // ⚠ 相机在 z=20、球心在 z=15，相距 5 个世界单位；球的世界半径 ≈ 1.009 x scale。
    //   所以 scale > 4.96（像素半径 ≈ 2710px）之后**相机就进了球里** ——
    //   材质默认 FrontSide，正面朝外、从内部全被背面剔除，球会整个消失。
    //   中途看得见，只是因为生长过程短暂经过了「相机在球外」那一段。
    // 加载完成后呼出**加载页那颗球**（球半径滑块那个尺寸，一直停在那里）。
    // ⚠ 用户要的是「不呼出**首页那颗小球**」（休止态 scale 0.10）—— 真组件的 handoff()
    //   会做这一步收缩，dev-ball 本来就没有，所以这里给 true 即可。
    var SUMMON_BALL = true;
    var BALL_RADIUS_PX = 663;     // 滑块可调（当前值）
    // 模型半径 ≈ 1.009 个世界单位（scale=1 时）；由实测反推：世界半径 5 对应 2045~4053px，
    // 而 worldPerPx()=0.0018285（1 世界单位 ≈ 547px），两者吻合。
    var MODEL_R_W = 1.009;
    var BALL_GAP_W = 0.2;         // 球面留在相机前方的世界距离（滑块可调，见 brd 旁）
    function summonScale() { return BALL_RADIUS_PX * worldPerPx(); }
    function scaleOfPx(px) { return px * worldPerPx(); }
    // 球心 z：把**球面**摆到相机前 BALL_GAP_W 处（相机在 z=CAM_Z）。
    // 半径小的时候这个式子会算出球心仍在前方（正常那颗球）—— 只有当世界半径 > 相机距球心的
    // 5 个单位时它才真正把球往后推，也就是「相机险些入球」时才生效。
    function summonZ() {
      var wr = summonScale() * MODEL_R_W;
      return CAM_Z - BALL_GAP_W - wr;
    }

    var el = document.getElementById('pl');
    var sceneEl = el.querySelector('.pl-scene');
    // 噪点纹句柄（与 Preloader.astro 同名段落一致）。本页没有 .pl-grain 元素，
    // grain 恒为 null、整段空转 —— 留着是为了让两份 makePlate 保持逐字相同，
    // 这样在 dev-ball 上量到的像素证据才能直接迁移到真组件上。
    var grain = el.querySelector('.pl-grain');
    el.querySelector('.pl-grid').innerHTML = new Array(12).fill('<i></i>').join('');
    var gcols = el.querySelectorAll('.pl-grid i');
    var numEl = el.querySelector('.pl-num');
    var vels = el.querySelectorAll('.pl-data s');
    var spd = document.getElementById('spd'), spdv = document.getElementById('spdv');
    var radEl = document.getElementById('rad'), stgEl = document.getElementById('stg');
    var btn = document.getElementById('play');
    var scrub = document.getElementById('scrub'), scrubv = document.getElementById('scrubv');
    var speed = 1, playing = true, clock = 0, last = performance.now();
    // 开场解析（模糊）的起止。终点**不是 0** —— 100% 与球出来时停在「原来 48% 那一档」
    // 的柔化上（与 Preloader.astro 同一套）。起点 = 终点 + 衰减区间；滑块可直接拖起点。
    var BLUR_END = 6.5 * (1 - 0.48 / 0.55);   // ≈ 0.83px
    var blurStart = BLUR_END + 6.5;           // ≈ 7.33px（保持原衰减区间）
    var blurPow = 2;                          // 缓入指数：1=线性，越大「开头越糊、末尾收得越猛」
    // T_HOLD：100% 之后停留多久才交班（呼出球）。用户要求「往前调一点点点」——
    // 0.5 → 0.4，整个呼出提前 0.1s。别一次调太多，这个量的意义就是「早这么一丁点」。
    // T_CALL：球从零长到满的时长。用户要求「扩大速度减慢一点」—— 1.2 → 1.7s（慢约 40%）。
    // 它同时决定「呼出球 → 落定」的分界，抽稀滑块会自动跟着走（TOTAL 由这几个常数算）。
    var T_LOAD = 5.0, T_HOLD = 0.4, T_CALL = 1.7, T_END = 1.6;
    // 呼出之后的收尾两段（用户要求）：先把球的光学褪到 0，再把球和加载页撤掉、露出首页。
    // 撤场不能硬切 —— 光学褪到 0 时球只是变成「中性玻璃」，屏幕上仍是**加载页**；
    // 此刻直接把底板删掉会「啪」地跳成首页。所以底板用 __lensScene 0→1 淡出、球同步缩没。
    var T_FADE = 0.3;   // 光学 1 → 0（用户要求加快）
    var T_OUT = 0.7;    // 底板淡出 + 球缩没
    var TOTAL = T_LOAD + T_HOLD + T_CALL + T_FADE + T_OUT + T_END;
    var swapped = false;

    spd.addEventListener('input', function () { speed = parseFloat(spd.value); spdv.textContent = speed.toFixed(2) + '×'; });
    // 模糊起点可拖：终点(0.83px)固定 —— 那是你指定的「停在原 48% 那一档」。
    var blr = document.getElementById('blr'), blrv = document.getElementById('blrv');
    blr.addEventListener('input', function () {
      blurStart = parseFloat(blr.value);
      blrv.textContent = blurStart.toFixed(1) + 'px';
    });
    // 曲线指数：1 = 线性（旧行为），2 = 缓入（默认），越大开头越糊、末尾收得越猛
    var bpw = document.getElementById('bpw'), bpwv = document.getElementById('bpwv');
    bpw.addEventListener('input', function () {
