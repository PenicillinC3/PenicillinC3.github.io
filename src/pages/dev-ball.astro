    // ⚠ 每处的百分比都必须与上面的 CSS 对齐，否则交班瞬间会跳一下。
    // 量某个元素的**文字基线 y**（与 Preloader.astro 同一套，别各写一份）。
    // 被块化的元素 rect.top 是**行盒**顶而非字形顶 → 基线 = 行盒顶 + 半行距 + 上升部；
    // asc/desc 取 canvas 的字体度量，浏览器给 DOM 排版用的就是同一套表。
    var _mc = document.createElement('canvas').getContext('2d');
    function baselineY(e, cs) {
