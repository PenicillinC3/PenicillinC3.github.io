---
import { getImage } from 'astro:assets';
import { render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import { createMarkdownProcessor } from '@astrojs/markdown-remark';
import Base from '../../layouts/Base.astro';
import Rays from '../../components/Rays.astro';
import ShotCard from '../../components/ShotCard.astro';
import { seriesRolls } from '../../lib/collections';
import { formatDate } from '../../lib/date';

export async function getStaticPaths() {
  const rolls = await seriesRolls();
  return rolls.map((r) => ({ params: { slug: r.entry.slug }, props: { roll: r } }));
}

interface Props {
  roll: { entry: CollectionEntry<'series'>; photos: CollectionEntry<'photos'>[]; cover: CollectionEntry<'photos'> };
}
const { roll } = Astro.props;
const { entry: s, photos } = roll;

// —— §81 图文交错 ——
// 卷 md 里独占一行的 ![[照片slug]] = 该照片卡片就地插入此处（照片说明由照片自己
// 的 md 提供）；未被标记的照片按顺序自动补到正文之后再按日期排进底部网格。
// 无任何标记时行为与旧版完全一致（正文块 + 底部照片网格）。
const MARK_RE = /^!\[\[([a-z0-9-]+)\]\]$/gim;
const marks = [...(s.body ?? '').matchAll(MARK_RE)];
const photoBySlug = new Map(photos.map((p) => [p.slug, p]));
for (const m of marks) {
  if (!photoBySlug.has(m[1])) {
    throw new Error(`[photos] 卷 ${s.slug} 的正文引用了不属于本卷的照片：${m[1]}`);
  }
}
const marked = new Set(marks.map((m) => m[1]));

// 正文切块：文字段渲染为 HTML，标记位置渲染为照片
const rawBody = s.body ?? '';
const md = await createMarkdownProcessor({ syntaxHighlight: 'prism' });
const parts: Array<{ kind: 'md'; html: string } | { kind: 'shot'; slug: string }> = [];
let cursor = 0;
for (const m of marks) {
  const before = rawBody.slice(cursor, m.index);
  if (before.trim()) {
    const r = await md.render(before);
    parts.push({ kind: 'md', html: r.code });
  }
  parts.push({ kind: 'shot', slug: m[1] });
  cursor = (m.index ?? 0) + m[0].length;
}
const tail = rawBody.slice(cursor);
const pureProse = marks.length === 0; // 无标记 → 旧路径（astro 原生 Content 组件）
if (!pureProse && tail.trim()) {
  const r = await md.render(tail);
  parts.push({ kind: 'md', html: r.code });
}
const restPhotos = photos.filter((p) => !marked.has(p.slug));
const { Content } = pureProse ? await render(s) : { Content: null };

// 每张照片的展示图（卷备忘页内最大宽度）
const imgs = await Promise.all(
  photos.map(async (p) => {
    // §76：压缩 —— 去掉 2400 档（展示宽 ≤1200px，1600 已覆盖 1.33x DPR，2x 场景
    //   由 1600 上采样可接受），quality 86→80
    const g = await getImage({
      src: p.data.image,
      widths: [900, 1600],
      sizes: '(min-width: 900px) min(88vw, 1200px), 100vw',
      format: 'webp',
      quality: 80,
    });
    const isPortrait = (p.data.image.height ?? 0) > (p.data.image.width ?? 0);
    return { p, src: g.src, srcset: g.attributes.srcset, isPortrait };
  }),
);
const imgBySlug = new Map(imgs.map((it) => [it.p.slug, it]));
---
<Base title={s.data.title} description={s.data.summary ?? `摄影备忘录：${s.data.title}`} dark>
  {/* 红色射线氛围（spec §26）：backdrop 沉于玻璃卡后方，随正文滚动 */}
  <Rays variant="backdrop" />
  <article class="memo">
    <p class="crumb"><a href="/photos/">← 摄影作品集</a></p>
    <header class="glass memohead">
      <h1 class="page-title">{s.data.title}</h1>
      <p class="meta">
        {formatDate(s.data.date)}
        {s.data.location && <span class="sep">·</span>}
        {s.data.location}
        <span class="sep">·</span>共 {photos.length} 张
      </p>
    </header>
    {/* §81：无 ![[slug]] 标记 → 旧路径（原生 Content）；有标记 → 文字段与照片按标记交错 */}
    {pureProse ? (
      s.body && s.body.trim() !== '' && <div class="prose memobody"><Content /></div>
    ) : (
      <div class="memoflow">
        {parts.map((pt) =>
          pt.kind === 'md' ? (
            <div class="prose memobody" set:html={pt.html} />
          ) : (
            <ShotCard data={imgBySlug.get(pt.slug)!} />
          ),
        )}
      </div>
    )}
    {restPhotos.length > 0 && (
      <div class="photos">
        {restPhotos.map((p) => <ShotCard data={imgBySlug.get(p.slug)!} />)}
      </div>
    )}
  </article>
</Base>

<style>
  .memo { display: grid; gap: clamp(22px, 3vw, 30px); }
  /* §79：备忘正文与个人笔记页同宽（Post.astro 同款 .prose.body 取消 68ch 窄栏）
     §80：正文/照片说明字号略微调大 —— 华文中宋小字号在暗底上笔画细、毛边感
     明显，放大后显著缓解（锯齿观感） */
  .prose.memobody {
    max-width: none;
    font-size: 1.1rem;
    line-height: 1.9;
  }
  .crumb {
    margin: 0;
    font-size: 0.88rem;
    font-family: var(--font-sans); /* 回退链接用 Maple（同导航，暗房页正文切宋体不影响它） */
  }
  .crumb a { color: var(--text-2); }
  /* 回退链接：悬停变色但无下划线（同 Post.astro 约定） */
  .crumb a:hover { color: var(--accent); text-decoration: none; }
  .memohead { padding: clamp(20px, 3.6vw, 34px) clamp(18px, 3.6vw, 36px); }
  .meta { margin: 6px 0 0; color: var(--text-3); font-size: 0.92rem; }
  .sep { padding: 0 6px; opacity: 0.6; }
  .memobody { margin-top: 2px; }
  /* §81：图文交错流（文字段与照片卡片同栅格间距，视觉节奏一致） */
  .memoflow {
    display: grid;
    gap: clamp(20px, 3.6vw, 34px);
  }
  .photos { display: grid; gap: clamp(26px, 5vw, 44px); }

  /* 暗房点缀（spec §21.3）：页头红光发丝线 */
  .memohead { border-bottom: 1px solid rgba(255, 107, 107, 0.45); box-shadow: var(--glass-inset), var(--glass-shadow), 0 10px 40px -18px rgba(255, 77, 77, 0.5); }
  .memohead .page-title { color: #fff; text-shadow: 0 0 24px rgba(255, 77, 77, 0.35); }
  .meta { color: var(--text-3); }
</style>
